{
  "description": "Keeps every Linode operation inside the project's tag boundary: refuses writes to resources outside the project, and records ownership for resource types that cannot carry tags.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/guard-linode.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/record-owned.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
