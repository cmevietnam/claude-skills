#!/usr/bin/env bash
# Project and environment boundary for Linode.
#
# linode-cli does everything else. lingate exists only for the things linode-cli
# has no concept of: which project and which environment this checkout is, which
# resources belong to them, and how to bring an old untagged resource inside.
#
# Ownership has two sources of truth, and never a third:
#   - taggable groups -> the resource's own tags field, on the API
#   - the rest        -> .linode/owned.json, committed in the repo
set -eu

here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
# shellcheck source=../scripts/lib/common.sh
. "$here/../scripts/lib/common.sh"
# shellcheck source=../scripts/lib/linode.sh
. "$here/../scripts/lib/linode.sh"

usage() {
  cat >&2 <<'USAGE'
lingate — project and environment boundary for Linode

  init <tag> [--envs a,b,c] [--default-env E] [--protect a,b] [--shared-envs]
                                         Declare which project this checkout is
  whoami                                 Current project/env, and which file says so
  ls [group]                             Resources this project owns
  orphans                                Resources with no tags — adoption candidates
  adopt <group> <id> --env E [--yes]     Bring an older resource into project + env
  own <group> <id> --env E [--label L]   Record an untaggable resource in the ledger
  disown <group> <id>                    Remove a resource from the ledger
  doctor                                 Check the whole setup and print the fixes

A command's env is taken, in order, from a LINODE_ENV=... prefix on the command
line, then the LINODE_ENV environment variable, then defaultEnv in .linode/project.json.

Environment: LINGATE_GUARD=off disables the guard, LINGATE_TTL=<s> changes the cache
TTL, LINGATE_BUDGET=<s> is the total API lookup budget for one hook run.
USAGE
}

require_project() {
  proj_root=$(find_project_root) || die \
    "no .linode/project.json found — run 'lingate init <tag>' at the repo root first"
  proj_tag=$(json_str_file "$proj_root/$LINGATE_CONFIG" tag)
  [[ -n "$proj_tag" ]] || die "$proj_root/$LINGATE_CONFIG has no \"tag\" field"
  proj_envs=$(json_arr_file "$proj_root/$LINGATE_CONFIG" envs | tr '\n' ' ')
  proj_envs=${proj_envs% }
  proj_protected=$(json_arr_file "$proj_root/$LINGATE_CONFIG" protectedEnvs | tr '\n' ' ')
  proj_protected=${proj_protected% }
  proj_default_env=$(json_str_file "$proj_root/$LINGATE_CONFIG" defaultEnv)
  proj_shared=$(json_bool_file "$proj_root/$LINGATE_CONFIG" allowSharedEnvs)
}

# The env a lingate subcommand acts on, same precedence the guard uses.
resolve_env() {
  local e="${1:-}"
  [[ -n "$e" ]] || e="${LINODE_ENV:-}"
  [[ -n "$e" ]] || e="$proj_default_env"
  [[ -n "$proj_envs" ]] || { printf '%s' "$e"; return 0; }
  case " $proj_envs " in
    *" $e "*) printf '%s' "$e" ;;
    *) die "env '$e' is not one of [$proj_envs] — pass --env <env>" ;;
  esac
}

lin() { linode-cli "$@" --suppress-warnings; }

# --- init -------------------------------------------------------------------
cmd_init() {
  local tag="" prefix="" region="" envs="dev,staging,prod" default_env="" protect="prod" root
  local shared="false"
  while (( $# )); do
    case "$1" in
      --prefix)      prefix="${2:-}"; shift 2 ;;
      --region)      region="${2:-}"; shift 2 ;;
      --envs)        envs="${2:-}"; shift 2 ;;
      --default-env) default_env="${2:-}"; shift 2 ;;
      --protect)     protect="${2:-}"; shift 2 ;;
      --shared-envs) shared="true"; shift ;;
      --no-envs)     envs=""; protect=""; default_env=""; shift ;;
      -*) die "unknown flag: $1" ;;
      *) [[ -z "$tag" ]] || die "only one tag is accepted"; tag="$1"; shift ;;
    esac
  done
  [[ -n "$tag" ]] || die "missing tag. Example: lingate init cme --region sg-sin-2"
  case "$tag" in *[!A-Za-z0-9_.-]*) die "a tag should contain only letters, digits, - _ . — got: $tag" ;; esac

  root=$(git rev-parse --show-toplevel 2>/dev/null) || root="$PWD"
  [[ -n "$prefix" ]] || prefix="$tag-"
  [[ -n "$default_env" || -z "$envs" ]] || default_env="${envs%%,*}"

  mkdir -p -- "$root/$LINGATE_DIR"
  [[ -f "$root/$LINGATE_CONFIG" ]] && warn "$root/$LINGATE_CONFIG already exists, overwriting" || true
  # The config is staged and moved into place last: if preparing the ledger
  # fails, nothing is left half-declared.
  local cfg_tmp="$root/$LINGATE_CONFIG.tmp.$$"
  {
    printf '{\n  "tag": "%s",\n  "labelPrefix": "%s"' "$tag" "$prefix"
    [[ -n "$region" ]] && printf ',\n  "defaultRegion": "%s"' "$region" || true
    if [[ -n "$envs" ]]; then
      printf ',\n  "envs": [%s]' "$(json_list "$envs")"
      printf ',\n  "defaultEnv": "%s"' "$default_env"
      printf ',\n  "protectedEnvs": [%s]' "$(json_list "$protect")"
      printf ',\n  "allowSharedEnvs": %s' "$shared"
    fi
    printf '\n}\n'
  } > "$cfg_tmp" || { rm -f -- "$cfg_tmp"; die "cannot write $root/$LINGATE_CONFIG"; }
  # A ledger that names another project is set aside, not adopted: carrying its
  # entries forward would hand that project's resources to this one.
  if [[ -f "$root/$LINGATE_LEDGER" ]]; then
    local old
    old=$(json_str_file "$root/$LINGATE_LEDGER" tag)
    if [[ "$old" != "$tag" ]]; then
      mv -f -- "$root/$LINGATE_LEDGER" "$root/$LINGATE_LEDGER.${old:-unknown}.bak" \
        || { rm -f -- "$cfg_tmp"; die "cannot set the old ledger $root/$LINGATE_LEDGER aside"; }
      warn "the old $LINGATE_LEDGER declared project '${old:-?}' — moved to $LINGATE_LEDGER.${old:-unknown}.bak, creating a new ledger for '$tag'"
      printf '' | ledger_save "$root" "$tag" || { rm -f -- "$cfg_tmp"; die "cannot create $root/$LINGATE_LEDGER"; }
    fi
  else
    printf '' | ledger_save "$root" "$tag" || { rm -f -- "$cfg_tmp"; die "cannot create $root/$LINGATE_LEDGER"; }
  fi
  mv -f -- "$cfg_tmp" "$root/$LINGATE_CONFIG"

  info "project '$tag' — $root/$LINGATE_CONFIG"
  [[ -n "$envs" ]] && info "envs: [${envs//,/ }], default '$default_env', protected [${protect//,/ }]" || true
  [[ "$shared" == true ]] && warn "allowSharedEnvs=true — a resource may serve several envs. This is deliberate technical debt; 'lingate doctor' will keep reminding you." || true
  info "commit the $LINGATE_DIR/ directory so the whole team shares this boundary"
}

# comma list -> JSON string array body
json_list() {
  local out="" item
  local IFS=,
  for item in $1; do
    [[ -z "$item" ]] && continue
    [[ -n "$out" ]] && out="$out, "
    out="$out\"$item\""
  done
  printf '%s' "$out"
}

# --- whoami -----------------------------------------------------------------
cmd_whoami() {
  require_project
  printf 'tag        %s\n' "$proj_tag"
  printf 'prefix     %s\n' "$(json_str_file "$proj_root/$LINGATE_CONFIG" labelPrefix)"
  printf 'region     %s\n' "$(json_str_file "$proj_root/$LINGATE_CONFIG" defaultRegion)"
  printf 'envs       %s\n' "${proj_envs:-(env tags not used)}"
  local cur note=""
  cur=$(resolve_env "")
  case " $proj_protected " in *" $cur "*) note="  [PROTECTED]" ;; esac
  printf 'env        %s%s\n' "$cur" "$note"
  printf 'shared     %s\n' "$([[ "$proj_shared" == true ]] && printf 'allowed (allowSharedEnvs)' || printf 'no')"
  printf 'config     %s\n' "$proj_root/$LINGATE_CONFIG"
  printf 'ledger     %s (%s entries)\n' "$proj_root/$LINGATE_LEDGER" \
    "$(ledger_entries "$proj_root" "$proj_tag" | grep -c . || true)"
}

# --- ls ---------------------------------------------------------------------
cmd_ls() {
  require_project
  local want="${1:-}" g rows rc
  for g in $LINGATE_TAGGABLE; do
    if [[ -n "$want" && "$want" != "$g" ]]; then continue; fi
    # An empty list and a failed call look identical downstream, and a silent
    # empty list is how you conclude a project owns nothing. The if-form matters:
    # under set -e a plain `rows=$(...)` that fails ends the script right here.
    if rows=$(lin "$g" "$(list_action_for "$g")" --tags "$proj_tag" \
                --text --no-headers --format 'id,label,tags' 2>/dev/null); then rc=0; else rc=$?; fi
    (( rc == 0 )) || { warn "could not read $g (linode-cli exit $rc) — the list below is INCOMPLETE"; continue; }
    printf '%s\n' "$rows" | awk -v g="$g" -F'\t' 'NF { printf "%-14s %-12s %-34s %s\n", g, $1, $2, $3 }'
  done
  for g in $LINGATE_LEDGER_GROUPS; do
    if [[ -n "$want" && "$want" != "$g" ]]; then continue; fi
    ledger_entries "$proj_root" "$proj_tag" | while IFS= read -r e; do
      [[ "$(json_str "$e" type)" == "$g" ]] || continue
      printf '%-14s %-12s %-34s %s\n' "$g" "$(json_str "$e" id)" \
        "$(json_str "$e" label)" "$(json_str "$e" env)"
    done
  done
}

# --- orphans ----------------------------------------------------------------
# Untagged resources belong to no project, which is exactly why nothing may touch
# them until someone decides. LKE worker nodes are left out: they are owned by
# their cluster and never tagged individually.
cmd_orphans() {
  require_project
  local g rows rc
  for g in $LINGATE_TAGGABLE; do
    # Linode's own distro images are public, untagged and not anyone's to adopt.
    local -a extra=()
    [[ "$g" == images ]] && extra=(--is_public false)
    if rows=$(lin "$g" "$(list_action_for "$g")" ${extra[@]+"${extra[@]}"} \
                --text --no-headers --format 'id,label,tags' 2>/dev/null); then rc=0; else rc=$?; fi
    (( rc == 0 )) || { warn "could not read $g (linode-cli exit $rc) — the list below is INCOMPLETE"; continue; }
    printf '%s\n' "$rows" | awk -v g="$g" -F'\t' '
        $3 == "" || $3 == "[]" {
          if (g == "linodes" && $2 ~ /^lke[0-9]+-/) next
          printf "%-14s %-12s %s\n", g, $1, $2
        }'
  done
}

# --- adopt ------------------------------------------------------------------
cmd_adopt() {
  require_project
  local group="" id="" env="" yes=0
  while (( $# )); do
    case "$1" in
      --yes|-y) yes=1; shift ;;
      --env)    env="${2:-}"; shift 2 ;;
      -*) die "unknown flag: $1" ;;
      *) if [[ -z "$group" ]]; then group="$1"; else id="$1"; fi; shift ;;
    esac
  done
  [[ -n "$group" && -n "$id" ]] || die "usage: lingate adopt <group> <id> --env <env> [--yes]"
  env=$(resolve_env "$env")

  case "$(group_scope "$group")" in
    ledger)   cmd_own "$group" "$id" --env "$env"; return ;;
    taggable) ;;
    *) die "'$group' is not a taggable type. Taggable types: $LINGATE_TAGGABLE" ;;
  esac

  local tags_out t
  tags_out=$(resolve_tags "$group" "$id") \
    || die "cannot look up $group $id — check: linode-cli $group $(view_action_for "$group") $id --json"

  local -a tags=() args=()
  while IFS= read -r t; do
    case "$t" in ''|@*) continue ;; esac
    tags[${#tags[@]}]="$t"
  done <<< "$tags_out"

  local -a want=()
  (( ${#tags[@]} > 0 )) && tags_contain "$proj_tag" "${tags[@]}" || want[${#want[@]}]="$proj_tag"
  if [[ -n "$proj_envs" ]]; then
    if (( ${#tags[@]} == 0 )) || ! tags_contain "$env" "${tags[@]}"; then
      # Adding a second environment turns this into a shared resource, which the
      # project has to have said yes to in advance.
      local existing
      existing=$(env_of_tags "$proj_envs" ${tags[@]+"${tags[@]}"} | tr '\n' ' ')
      existing=${existing% }
      if [[ -n "$existing" && "$proj_shared" != true ]]; then
        die "$group $id is already in env '$existing'; adding '$env' would make it a shared resource.
     If that is intended (one box serving two envs to save cost), set \"allowSharedEnvs\": true
     in $proj_root/$LINGATE_CONFIG. Otherwise remove '$existing' first."
      fi
      want[${#want[@]}]="$env"
    fi
  fi
  if (( ${#want[@]} == 0 )); then
    info "$group $id already carries '$proj_tag'${proj_envs:+ and '$env'}, nothing to do"
    return 0
  fi

  for t in ${tags[@]+"${tags[@]}"};  do args[${#args[@]}]="--tags"; args[${#args[@]}]="$t"; done
  for t in "${want[@]}";             do args[${#args[@]}]="--tags"; args[${#args[@]}]="$t"; done

  if (( yes == 0 )); then
    info "would run: linode-cli $group $(update_action_for "$group") $id ${args[*]}"
    info "tags: [${tags[*]-}] → [${tags[*]-} ${want[*]}]"
    info "ask the user first, then rerun with --yes"
    return 0
  fi
  # The cached answer goes first: once the API has changed, a stale cache is the
  # one thing that could still make the guard refuse what was just adopted.
  rm -f -- "$LINGATE_CACHE_HOME/$group-${id//\//_}.json" 2>/dev/null || true
  # update is a PUT that replaces the whole array, so every existing tag is sent
  # back alongside the new ones.
  lin "$group" "$(update_action_for "$group")" "$id" "${args[@]}" \
    --text --no-headers --format 'id,label,tags' >&2 \
    || die "linode-cli $group $(update_action_for "$group") $id failed — tags unchanged"
  rm -f -- "$LINGATE_CACHE_HOME/$group-${id//\//_}.json" 2>/dev/null || true
  info "$group $id now belongs to project '$proj_tag'${proj_envs:+, env '$env'}"
}

# --- own / disown -----------------------------------------------------------
cmd_own() {
  require_project
  local group="${1:-}" id="${2:-}" label="" env=""
  shift 2 2>/dev/null || true
  while (( $# )); do
    case "$1" in
      --label) label="${2:-}"; shift 2 ;;
      --env)   env="${2:-}"; shift 2 ;;
      *) shift ;;
    esac
  done
  [[ -n "$group" && -n "$id" ]] || die "usage: lingate own <group> <id> --env <env> [--label L]"
  case " $LINGATE_LEDGER_GROUPS " in
    *" $group "*) ;;
    *) die "'$group' can carry tags on the API, do not ledger it — use 'lingate adopt $group $id'" ;;
  esac
  case "$id" in
    *[!A-Za-z0-9._/-]*|"") die "an id should contain only letters, digits, . _ - / — got: $id" ;;
  esac
  ledger_is_ours "$proj_root" "$proj_tag" || [[ ! -f "$proj_root/$LINGATE_LEDGER" ]] || die \
    "$proj_root/$LINGATE_LEDGER declares project '$(json_str_file "$proj_root/$LINGATE_LEDGER" tag)', not '$proj_tag'. Run 'lingate init $proj_tag' to set the old ledger aside and create a new one."
  env=$(resolve_env "$env")

  local existing
  existing=$(ledger_envs_of "$proj_root" "$proj_tag" "$group" "$id" | tr '\n' ' ')
  existing=${existing% }
  case " $existing " in
    *" $env "*) info "$group $id (env '$env') is already in the ledger"; return 0 ;;
  esac
  if [[ -n "$existing" && "$proj_shared" != true ]]; then
    die "$group $id is already in env '$existing' in the ledger; adding '$env' would make it a shared resource.
     If that is intended, set \"allowSharedEnvs\": true in $proj_root/$LINGATE_CONFIG."
  fi

  { ledger_entries "$proj_root" "$proj_tag"
    printf '{"type": "%s", "id": "%s", "env": "%s", "label": "%s", "at": "%s"}\n' \
      "$group" "$id" "$env" "$(json_escape "$label")" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } | ledger_save "$proj_root" "$proj_tag" \
    || die "cannot write $proj_root/$LINGATE_LEDGER"
  info "recorded $group $id (env '$env') → $proj_root/$LINGATE_LEDGER (remember to commit)"
}

cmd_disown() {
  require_project
  local group="${1:-}" id="${2:-}" e
  [[ -n "$group" && -n "$id" ]] || die "usage: lingate disown <group> <id>"
  ledger_is_ours "$proj_root" "$proj_tag" || die \
    "$proj_root/$LINGATE_LEDGER declares another project — run 'lingate init $proj_tag' first"
  ledger_has "$proj_root" "$proj_tag" "$group" "$id" || die "$group $id is not in the ledger"
  # Compare parsed fields: a human who reformats the file must not turn this
  # into a silent no-op.
  ledger_entries "$proj_root" "$proj_tag" | while IFS= read -r e; do
    [[ "$(json_str "$e" type)" == "$group" && "$(json_str "$e" id)" == "$id" ]] && continue
    printf '%s\n' "$e"
  done | ledger_save "$proj_root" "$proj_tag" \
    || die "cannot write $proj_root/$LINGATE_LEDGER"
  info "removed $group $id from the ledger"
}

# --- doctor -----------------------------------------------------------------
cmd_doctor() {
  local fail=0 root tag out envs
  info "checking the setup"

  if command -v linode-cli >/dev/null 2>&1; then
    ok "linode-cli: $(linode-cli --version 2>/dev/null | head -1)"
  else
    bad "linode-cli not installed → pip3 install linode-cli"; fail=1
  fi

  if out=$(linode-cli account view --text --no-headers --format 'email' 2>&1); then
    ok "token works (account: $(printf '%s' "$out" | tail -1))"
  else
    bad "API call failed → run 'linode-cli configure'"; fail=1
  fi
  if printf '%s' "${out:-}" | grep -q "newer than the CLI"; then
    warn "the CLI spec is older than the API → pip3 install --upgrade linode-cli"
  fi

  if root=$(find_project_root); then
    tag=$(json_str_file "$root/$LINGATE_CONFIG" tag)
    if [[ -n "$tag" ]]; then
      ok "project '$tag' — $root/$LINGATE_CONFIG"
    else
      bad "$root/$LINGATE_CONFIG has no \"tag\" field"; fail=1
    fi
    envs=$(json_arr_file "$root/$LINGATE_CONFIG" envs | tr '\n' ' ')
    if [[ -n "${envs// /}" ]]; then
      local prot; prot=$(json_arr_file "$root/$LINGATE_CONFIG" protectedEnvs | tr '\n' ' ')
      ok "envs: [${envs% }], default '$(json_str_file "$root/$LINGATE_CONFIG" defaultEnv)', protected [${prot% }]"
    else
      warn "the project declares no envs — the cross-env guard is off"
    fi
    if linode-cli tags list --text --no-headers --suppress-warnings 2>/dev/null | grep -qx "$tag"; then
      ok "tag '$tag' exists on the account"
    else
      warn "tag '$tag' is attached to nothing yet — normal for a new project"
    fi
    if [[ -f "$root/$LINGATE_LEDGER" ]]; then
      if [[ "$(json_str_file "$root/$LINGATE_LEDGER" tag)" == "$tag" ]]; then
        ok "ledger: $(ledger_entries "$root" "$tag" | grep -c . || true) entries"
      else
        bad "$LINGATE_LEDGER declares project '$(json_str_file "$root/$LINGATE_LEDGER" tag)', not '$tag'"; fail=1
      fi
    else
      warn "no $LINGATE_LEDGER yet — it is created when needed"
    fi
    cmd_shared_debt "$root" "$tag" "$envs"
  else
    bad "no .linode/project.json found → lingate init <tag>"; fail=1
  fi

  if [[ "$LINGATE_GUARD" == off ]]; then
    warn "LINGATE_GUARD=off — the guard is OFF, every write goes through"
  else
    ok "the PreToolUse guard is on"
  fi
  return "$fail"
}

# Resources serving more than one environment. Allowed when the project says so,
# but they are the reason a staging command can reach production, so doctor keeps
# them visible instead of letting them become invisible normality.
cmd_shared_debt() {
  local root="$1" tag="$2" envs="$3" g rows rc n=0
  [[ -n "${envs// /}" ]] || return 0
  for g in $LINGATE_TAGGABLE; do
    rows=$(linode-cli "$g" "$(list_action_for "$g")" --tags "$tag" \
             --text --no-headers --format 'id,label,tags' --suppress-warnings 2>/dev/null) || continue
    while IFS=$'\t' read -r rid rlabel rtags; do
      [[ -n "$rid" ]] || continue
      local hits=0 e
      for e in $envs; do
        case " $rtags " in *" $e "*) hits=$((hits + 1)) ;; esac
      done
      if (( hits > 1 )); then
        warn "shared envs: $g $rid ($rlabel) → [$rtags]"
        n=$((n + 1))
      fi
    done <<< "$rows"
  done
  if (( n > 0 )); then
    warn "$n resource(s) serve several environments. Fine when allowSharedEnvs=true, but each one is a place where a staging command reaches prod — split them when the budget allows."
  else
    ok "no resource serves several environments"
  fi
}

# --- dispatch ---------------------------------------------------------------
sub="${1:-help}"
shift 2>/dev/null || true
case "$sub" in
  init)    cmd_init "$@" ;;
  whoami)  cmd_whoami "$@" ;;
  ls|list) cmd_ls "$@" ;;
  orphans) cmd_orphans "$@" ;;
  adopt)   cmd_adopt "$@" ;;
  own)     cmd_own "$@" ;;
  disown)  cmd_disown "$@" ;;
  doctor)  cmd_doctor "$@" ;;
  help|-h|--help) usage ;;
  *) usage; exit 64 ;;
esac
