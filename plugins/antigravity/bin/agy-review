#!/usr/bin/env python3
"""Run one headless `agy` review and refuse to call it a success unless it really was.

`agy` exits 0 with status=SUCCESS and an empty response when every tool it wanted was
auto-denied, which is the default headless. This wrapper treats that — and an empty
output file, non-JSON output, a populated `error`, and any `denied_actions` — as hard
failures.

Usage:
  agy-review [options] PROMPT_FILE     run the prompt, validate, print the response
  agy-review --check ENVELOPE_JSON     validate an envelope that already exists

Options:
  --model M      model id (default: gemini-3.8-flash)
  --effort E     low|medium|high. Passed only when the model accepts it; see below.
  --out DIR      where to keep out.json and err.txt. Default: a private mkdtemp
                 directory. An existing out.json/err.txt is never overwritten, so two
                 models get two directories and no raw report is lost.
  --timeout T    --print-timeout value (default: 9m)
  --agy PATH     agy binary: a bare name is resolved on PATH, a path is used as given
                 (default: agy, then ~/.local/bin/agy)

The prompt is passed to `agy` as a command-line argument, because `agy -p` does not read
stdin. On a shared machine that makes its full text visible to anyone who can list
processes — do not put secrets in a review bundle.

Effort handling: `agy` rejects --effort for models that bake the level into the id
(gemini-3.8-flash-high) and for models that do not support it at all (claude-sonnet-4-6,
claude-opus-4-6-thinking). Given no explicit --effort, this wrapper applies the default
only to an unsuffixed `gemini-*` id and omits it everywhere else. An explicit --effort is
always passed through, so `agy`'s own error surfaces rather than being silently dropped.

Exit codes: 0 review produced, 1 run failed or was incomplete, 2 usage error.
"""

import argparse
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile

EFFORT_SUFFIXES = ("-high", "-medium", "-low")

# The review is UTF-8 whatever the locale says: agy emits UTF-8, and printing it through
# an ASCII stdout would raise UnicodeEncodeError on a perfectly good review.
for _stream in (sys.stdout, sys.stderr):
    try:
        _stream.reconfigure(encoding="utf-8")
    except (AttributeError, ValueError):  # pragma: no cover - very old Python
        pass


def die(msg, code=1):
    print(msg, file=sys.stderr)
    raise SystemExit(code)


def write_response(text):
    """Emit the review byte-for-byte — no added or removed newline."""
    sys.stdout.write(text)
    if not text.endswith("\n"):
        sys.stdout.write("\n")


def takes_effort(model):
    """True when `model` is an id that accepts a separate --effort flag.

    Verified against agy 1.1.27: a suffixed id conflicts ("conflicts with --effort=high")
    and the Claude ids are refused outright ("--effort is not supported for model ...").
    """
    if model.endswith(EFFORT_SUFFIXES):
        return False
    return bool(re.match(r"^gemini-", model))


def read_text(path):
    """Read a text file as UTF-8 regardless of locale — agy emits raw UTF-8 JSON."""
    with open(path, encoding="utf-8") as f:
        return f.read()


def read_envelope(path, err_path=None):
    hint = f" — see {err_path}" if err_path else ""
    try:
        raw = read_text(path).strip()
    except OSError as e:
        die(f"FAILED: cannot read {path}: {e}")
    except UnicodeDecodeError as e:
        die(f"FAILED: {path} is not valid UTF-8 ({e}){hint}")

    if not raw:
        die(f"FAILED: empty output file, the run produced nothing{hint}")

    try:
        env = json.loads(raw)
    except json.JSONDecodeError as e:
        die(f"FAILED: output is not JSON ({e}){hint}\nfirst 200 bytes: {raw[:200]!r}")
    except RecursionError:
        # Pathologically nested JSON blows the parser's stack; that is a bad envelope,
        # not a reason to print a traceback.
        die(f"FAILED: output JSON is nested too deeply to parse{hint}")

    if not isinstance(env, dict):
        die(f"FAILED: output is not a JSON object, got {type(env).__name__}{hint}")
    return env


def validate(path, err_path=None):
    """Return (response, envelope), or exit non-zero explaining why the run is unusable."""
    env = read_envelope(path, err_path)
    hint = f" — see {err_path}" if err_path else ""

    if env.get("error"):
        die(f"FAILED: status={env.get('status')} error={env['error']}")
    if env.get("status") != "SUCCESS":
        die(f"FAILED: status={env.get('status')}{hint}")
    if env.get("denied_actions"):
        die(
            "FAILED: the run was incomplete — these tools were auto-denied: "
            f"{env['denied_actions']}\n"
            "Either put the material in the prompt and forbid tool use, or add "
            "allow-rules to ~/.gemini/antigravity-cli/settings.json."
        )

    raw_response = env.get("response")
    if raw_response is not None and not isinstance(raw_response, str):
        die(
            f"FAILED: `response` is {type(raw_response).__name__}, not a string{hint}"
        )
    # Strip ONLY to decide emptiness. The response itself is returned untouched — this
    # tool's whole premise is that the reviewer's words reach the user verbatim, and
    # leading whitespace can be the indentation of a markdown code block.
    if not (raw_response or "").strip():
        die(f"FAILED: empty response, nothing was reviewed{hint}")
    response = raw_response

    # `usage` is cosmetic: it is reported, never trusted. A wrong type must not crash the
    # run — and must not discard a review that is otherwise complete either. Warn, drop it.
    usage = env.get("usage")
    if usage is not None and not isinstance(usage, dict):
        print(
            f"warning: `usage` is {type(usage).__name__}, not an object; "
            "token counts unavailable",
            file=sys.stderr,
        )
        env = dict(env, usage={})
    return response, env


def usable_binary(path):
    return os.path.isfile(path) and os.access(path, os.X_OK)


def find_agy(explicit):
    if explicit:
        # A bare name is resolved through PATH and ONLY through PATH — falling back to a
        # relative path would run ./<name> from the working directory.
        if os.sep not in explicit:
            found = shutil.which(explicit)
            if found:
                return found
            die(f"FAILED: agy binary `{explicit}` not found on PATH", 2)
        expanded = os.path.expanduser(explicit)
        if usable_binary(expanded):
            return expanded
        die(f"FAILED: agy binary not found or not executable at {explicit}", 2)
    found = shutil.which("agy")
    if found:
        return found
    fallback = os.path.expanduser("~/.local/bin/agy")
    if usable_binary(fallback):
        return fallback
    die("FAILED: `agy` not found on PATH or at ~/.local/bin/agy", 2)


def main():
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("target", nargs="?")
    ap.add_argument("--check", metavar="ENVELOPE_JSON")
    # Defaults stay None so "not given" is distinguishable from "given the default",
    # which is what lets --check reject run options instead of ignoring them.
    ap.add_argument("--model", default=None)
    ap.add_argument("--effort", default=None)
    ap.add_argument("--out")
    ap.add_argument("--timeout", default=None)
    ap.add_argument("--agy")
    ap.add_argument("-h", "--help", action="store_true")
    args = ap.parse_args()

    if args.help:
        print(__doc__)
        return 0

    if args.check:
        # --check validates an existing envelope; nothing about a run applies to it.
        # Silently ignoring run options would hide a mistyped command.
        conflicting = [
            name
            for name, value in (
                ("PROMPT_FILE", args.target),
                ("--out", args.out),
                ("--agy", args.agy),
                ("--effort", args.effort),
                ("--model", args.model),
                ("--timeout", args.timeout),
            )
            if value is not None
        ]
        if conflicting:
            die(
                f"usage: --check takes no run options, got: {', '.join(conflicting)}", 2
            )
        response, _ = validate(args.check)
        write_response(response)
        return 0

    model = args.model or "gemini-3.8-flash"
    timeout = args.timeout or "9m"

    if not args.target:
        die("usage: agy-review [options] PROMPT_FILE | --check ENVELOPE_JSON", 2)
    if not os.path.isfile(args.target):
        die(f"FAILED: prompt file not found: {args.target}", 2)

    try:
        prompt = read_text(args.target)
    except OSError as e:
        die(f"FAILED: cannot read prompt file {args.target}: {e}", 2)
    except UnicodeDecodeError as e:
        die(f"FAILED: prompt file {args.target} is not valid UTF-8 ({e})", 2)
    if not prompt.strip():
        die("FAILED: prompt file is empty", 2)
    if "\0" in prompt:
        # exec() cannot carry a NUL; without this the failure is a ValueError traceback
        # from deep inside subprocess.
        die(f"FAILED: prompt file {args.target} contains a NUL byte", 2)

    binary = find_agy(args.agy)

    # Default to a private 0700 directory. A predictable shared path under /tmp would
    # expose the review — prompt and response both — to any local user, and invites
    # pre-created-file and symlink attacks.
    try:
        if args.out:
            os.makedirs(args.out, mode=0o700, exist_ok=True)
            out_dir = args.out
            # makedirs' mode applies only when it creates the directory. An existing
            # 0755 --out would leave the report world-readable, so say so rather than
            # silently changing permissions on a directory the caller owns.
            mode = stat.S_IMODE(os.stat(out_dir).st_mode)
            if mode & (stat.S_IRWXG | stat.S_IRWXO):
                print(
                    f"warning: {out_dir} is mode {mode:04o}; other local users can list "
                    "it. The report files themselves are created 0600.",
                    file=sys.stderr,
                )
        else:
            out_dir = tempfile.mkdtemp(prefix="agy-review-")
    except OSError as e:
        die(f"FAILED: cannot use output directory {args.out or '(temp)'}: {e}", 2)

    out_path = os.path.join(out_dir, "out.json")
    err_path = os.path.join(out_dir, "err.txt")

    # Refuse to clobber a previous run's raw report: two models written to one --out
    # would destroy the first, and an attacker-planted symlink would be followed.
    for path in (out_path, err_path):
        if os.path.lexists(path):
            die(
                f"FAILED: {path} already exists — pick a different --out so an earlier "
                "run's raw report is not overwritten",
                2,
            )

    cmd = [
        binary,
        "-p", prompt,
        "--model", model,
        "--disable-slash-commands",
        "--output-format", "json",
        "--print-timeout", timeout,
    ]
    if args.effort is not None:
        cmd += ["--effort", args.effort]
    elif takes_effort(model):
        cmd += ["--effort", "high"]

    def private_create(path):
        """O_CREAT|O_EXCL (never follows a symlink) at mode 0600, umask notwithstanding."""
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        return os.fdopen(fd, "wb")

    try:
        with private_create(out_path) as out_f, private_create(err_path) as err_f:
            rc = subprocess.call(cmd, stdin=subprocess.DEVNULL, stdout=out_f, stderr=err_f)
    except OSError as e:
        die(f"FAILED: could not run {binary}: {e}", 2)
    except ValueError as e:
        die(f"FAILED: could not run {binary}: {e}", 2)

    print(f"raw output: {out_path}", file=sys.stderr)
    print(f"stderr:     {err_path}", file=sys.stderr)

    # A non-zero exit is reported with its code before any envelope complaint, so the
    # real failure is never masked by "empty output file".
    if rc != 0:
        detail = ""
        try:
            raw = read_text(out_path).strip()
            if raw:
                parsed = json.loads(raw)
                if isinstance(parsed, dict) and parsed.get("error"):
                    detail = f": {parsed['error']}"
        except (OSError, UnicodeDecodeError, json.JSONDecodeError):
            pass
        die(f"FAILED: agy exited {rc}{detail} — see {err_path}")

    response, env = validate(out_path, err_path)

    usage = env.get("usage") or {}
    print(
        f"model={model} conversation={env.get('conversation_id')} "
        f"tokens={usage.get('total_tokens')} turns={env.get('num_turns')}",
        file=sys.stderr,
    )
    write_response(response)
    return 0


if __name__ == "__main__":
    sys.exit(main())
