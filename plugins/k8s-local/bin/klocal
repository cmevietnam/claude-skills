#!/usr/bin/env bash
# klocal - bring a project's stack up on a local Kubernetes cluster, and tear it
# down again by deleting one namespace.
#
# The design rule: this script knows how a local cluster behaves, and nothing
# about any particular project. Everything project-shaped lives in a committed
# .k8s-local/project.json, so the same klocal drives every repo.
#
#   klocal scaffold      write manifests + config into a new project
#   klocal up            build, apply, wait, then print what to do next
#   klocal status        what is actually running, and where it drifts from the manifests
#   klocal down          delete the namespace
#
# Standalone: needs kubectl, a container engine, and jq or python3. Nothing from
# Claude Code. Symlink it onto PATH and use it like any other tool.
set -euo pipefail

here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
# shellcheck source=../scripts/lib/common.sh
. "$here/../scripts/lib/common.sh"
# shellcheck source=../scripts/lib/cluster.sh
. "$here/../scripts/lib/cluster.sh"

KL_TEMPLATES="$here/../skills/k8s-local/templates"

usage() {
  cat <<'EOF'
klocal - run this project's stack on a local Kubernetes cluster

  klocal up [--no-build]     build the image, apply the overlay, wait for rollout
  klocal down [--yes]        delete the namespace and everything in it
  klocal status              pods, services, ingress, reachability, manifest drift
  klocal logs [workload]     follow logs (default: the app workload)
  klocal rebuild             rebuild the image and restart the rollout
  klocal psql [--app] [args] psql in the database pod (--app: as the app role)
  klocal scaffold [dir]      write manifests + .k8s-local/project.json into a project
  klocal help                this text

Configuration lives in .k8s-local/project.json, found by walking up from $PWD.
Every command that touches the cluster refuses a context that is not local.
EOF
}

# ---------------------------------------------------------------------------
# preflight - every guard that must hold before anything touches the cluster.
# Sets KL_CONTEXT, which pins every later kubectl call (kl_kubectl).
# ---------------------------------------------------------------------------
require_cluster() {
  command -v kubectl >/dev/null 2>&1 || kl_die "kubectl not found"
  KL_CONTEXT=$(kl_require_local_context)
  # Remembered so it can be re-checked after the build; see kl_assert_context_unchanged.
  KL_SERVER_HOST=$(kl_context_server_host "$KL_CONTEXT" || true)
}

preflight() {
  kl_info "preflight"
  require_cluster
  kl_step "context: $KL_CONTEXT"
  kl_step "namespace: $KL_NAMESPACE"
  kl_check_ingressclass "$KL_INGRESS_CLASS"
  check_namespace_agreement
}

# kustomize carries its own `namespace:`, and it is the one that decides where
# resources land. If it disagrees with project.json, klocal would wait on a
# rollout in one namespace while the objects went to another, and `down` would
# later delete the wrong one.
check_namespace_agreement() {
  local kf declared
  kf=$(kustomization_file) || return 0
  # Accept the spellings kustomize itself accepts: an optionally quoted key, and
  # space before the colon. Matching only `^namespace:` missed `"namespace":`,
  # which kustomize honours — so resources went to one namespace while klocal
  # waited in, and later deleted, another.
  declared=$(sed -n -E 's/^[[:space:]]*["'\'']?namespace["'\'']?[[:space:]]*:[[:space:]]*//p' "$kf" |
    head -1 | tr -d '"'\''' | tr -d '[:space:]')
  [ -n "$declared" ] || return 0
  [ "$declared" = "$KL_NAMESPACE" ] || kl_die \
    "namespace mismatch: project.json says '$KL_NAMESPACE' but
       ${kf#"$KL_ROOT"/} says '$declared'. Resources would be applied to one and
       waited on (and later deleted) in the other. Make them agree."
}

# kustomize accepts three filenames, in this precedence order.
kustomization_file() {
  local d="$KL_ROOT/$KL_MANIFESTS" n
  for n in kustomization.yaml kustomization.yml Kustomization; do
    [ -f "$d/$n" ] && {
      printf '%s\n' "$d/$n"
      return 0
    }
  done
  return 1
}

# ---------------------------------------------------------------------------
# up
# ---------------------------------------------------------------------------
cmd_up() {
  local build=1
  [ "${1:-}" = "--no-build" ] && build=0
  kl_load_config
  preflight

  if [ "$build" = 1 ]; then
    kl_info "build $KL_IMAGE"
    kl_build_image "$KL_IMAGE" "$KL_ROOT/$KL_IMAGE_CONTEXT"
  else
    kl_info "build skipped (--no-build)"
  fi

  # A build takes minutes. Re-check before the first write that the context still
  # exists, still resolves to the same API server, and has gained no proxy-url:
  # pinning --context carries the NAME forward, not the cluster it named.
  kl_assert_context_unchanged "$KL_CONTEXT" "$KL_SERVER_HOST"

  kl_info "namespace"
  kl_kubectl create namespace "$KL_NAMESPACE" --dry-run=client -o yaml |
    kl_kubectl apply -f - >/dev/null
  kl_step "namespace/$KL_NAMESPACE ready"

  # The project owns its secret material; klocal only calls the hook. Keeping
  # this out-of-process is what lets secrets come from a vault without any
  # value passing through this script or landing on disk.
  if [ -n "$KL_SECRET_HOOK" ]; then
    kl_info "secret"
    kl_step "running $KL_SECRET_HOOK"
    # KL_KUBECTL carries the pin into the hook. A hook that calls bare `kubectl`
    # is NOT covered by this process's --context, so it would follow whatever the
    # kubeconfig says at that moment; the documented example uses "$KL_KUBECTL".
    (cd "$KL_ROOT" && KL_NAMESPACE="$KL_NAMESPACE" KL_SECRET="$KL_SECRET" \
      KL_CONTEXT="$KL_CONTEXT" KL_SECRET_ENV_FILE="$KL_SECRET_ENV_FILE" \
      KL_KUBECTL="kubectl --context $KL_CONTEXT" \
      sh -c "$KL_SECRET_HOOK")
  fi

  kl_info "apply $KL_MANIFESTS"
  if kustomization_file >/dev/null; then
    kl_kubectl apply -k "$KL_ROOT/$KL_MANIFESTS"
  else
    kl_kubectl apply -n "$KL_NAMESPACE" -f "$KL_ROOT/$KL_MANIFESTS"
  fi

  kl_info "waiting for rollout"
  local w
  for w in $KL_DB $KL_CACHE $KL_APP; do
    [ -n "$w" ] || continue
    kl_kubectl rollout status "deployment/$w" -n "$KL_NAMESPACE" --timeout=180s
  done

  next_steps
}

# The closing message is the documentation. Someone who runs `up` and reads the
# last twenty lines should not need any other file to get to a working stack.
next_steps() {
  # Read the hostnames off the live Ingress objects rather than assuming a
  # convention like api.<domain> — the cluster is the authority on what it serves.
  local hosts reach
  hosts=$(kl_ingress_hosts "$KL_NAMESPACE")
  if [ -n "$hosts" ]; then
    # With a TLS front door the reachable URL is https on the proxy port; the
    # Ingress itself is behind it and is not what a browser should be given.
    if [ -n "$KL_TLS_PORT" ]; then
      reach=$(printf '%s' "$hosts" | sed "s|^|https://|;s|\$|:$KL_TLS_PORT|" | paste -sd' ' -)
    else
      reach=$(printf '%s' "$hosts" | sed "s|^|http://|" | paste -sd' ' -)
    fi
  else
    reach="no Ingress in this namespace — use: kubectl port-forward -n $KL_NAMESPACE svc/$KL_APP 8080:80"
  fi

  cat >&2 <<EOF

Stack is up in namespace $KL_NAMESPACE.

  The datastores have no volume: everything is lost when a pod restarts, and
  migrations must be re-run after one. That is deliberate — see
  references/bring-up.md.

  Reach it:   $reach
              (lvh.me, nip.io and sslip.io resolve every name to 127.0.0.1; if
               $KL_ROOT_DOMAIN is not one of those, add a hosts entry.)
  Logs:       klocal logs
  Drift:      klocal status
  Teardown:   klocal down
EOF
}

# ---------------------------------------------------------------------------
# status - what is running, and where it disagrees with the manifests
# ---------------------------------------------------------------------------
cmd_status() {
  kl_load_config
  local ctx
  ctx=$(kl_current_context)
  printf 'context:   %s%s\n' "${ctx:-<none>}" \
    "$(kl_context_is_local "${ctx:-}" || printf '  (NOT verifiably local)')"
  printf 'namespace: %s\n\n' "$KL_NAMESPACE"

  # status only reads, but reading is still a query against someone's cluster, so
  # it applies the same two checks as the write commands — name AND API server
  # address — and reports instead of querying when either fails.
  if ! kl_context_is_local "${ctx:-}"; then
    printf 'refusing to query a context that is not verifiably local (name and API\n'
    printf 'server address must both check out); switch context to inspect the local stack\n'
    return 0
  fi
  KL_CONTEXT="$ctx"

  if ! kl_kubectl get namespace "$KL_NAMESPACE" >/dev/null 2>&1; then
    printf 'namespace %s does not exist — run: klocal up\n' "$KL_NAMESPACE"
    return 0
  fi

  kl_kubectl get pods,svc,ingress -n "$KL_NAMESPACE"

  printf '\nstorage:\n'
  local pvc
  pvc=$(kl_kubectl get pvc -n "$KL_NAMESPACE" --no-headers 2>/dev/null | wc -l | tr -d ' ')
  if [ "$pvc" = "0" ]; then
    printf '  no PVC — datastores are ephemeral, a pod restart wipes them\n'
  else
    kl_kubectl get pvc -n "$KL_NAMESPACE"
  fi

  printf '\ndrift (manifest vs live):\n'
  # A missing or empty manifests directory must not read as "nothing wrong" —
  # that is a false all-clear, which is worse than no check at all.
  if [ ! -d "$KL_ROOT/$KL_MANIFESTS" ]; then
    printf '  manifests directory not found: %s\n' "$KL_MANIFESTS"
    printf '  nothing was checked — fix "manifests" in %s\n' "${KL_CONFIG#"$KL_ROOT"/}"
    return 0
  fi
  local scanned
  scanned=$(kl_manifest_files "$KL_ROOT/$KL_MANIFESTS" | grep -c . || true)
  if [ "${scanned:-0}" -eq 0 ]; then
    printf '  no .yaml/.yml files under %s — nothing was checked\n' "$KL_MANIFESTS"
    return 0
  fi

  local found=0 unreadable=0 f kind workload ckind container name count
  local live n effective source
  while read -r f; do
    [ -n "$f" ] || continue
    while read -r kind workload ckind container name count; do
      case "$kind" in
        UNREADABLE)
          unreadable=$((unreadable + 1))
          printf '  %s: an env block uses %s, which this scanner cannot read\n' \
            "${f##*/}" "$ckind"
          printf '    check that file by hand — it was NOT analysed\n'
          continue
          ;;
        DUP) : ;;
        *) continue ;;
      esac
      found=1
      printf '  %s declared %sx in %s (%s/%s container %s)\n' \
        "$name" "$count" "${f##*/}" "$workload" "$ckind" "$container"
      # Query the workload the manifest actually defines, not always the app:
      # a duplicate in the Postgres manifest was previously looked up on the API
      # Deployment and reported as "not set".
      live=$(kl_env_of "$KL_NAMESPACE" "$workload" "$ckind" "$container" "$name" | grep . || true)
      n=$(printf '%s' "$live" | grep -c . || true)
      if [ "${n:-0}" -gt 1 ]; then
        # Both survived into the live spec: the kubelet builds env in order, so
        # the last one is what the container actually sees.
        effective=$(printf '%s' "$live" | tail -1)
        printf '    live spec holds %s copies; the container sees the last: %s\n' \
          "$n" "$(printf '%s' "$effective" | cut -f1)"
      elif [ "${n:-0}" -eq 1 ]; then
        source=$(printf '%s' "$live" | cut -f2)
        if [ "$source" = "value" ]; then
          printf '    collapsed to one before apply; live value: %s\n' \
            "$(printf '%s' "$live" | cut -f1)"
        else
          # Not a blank value — it comes from elsewhere. Reporting it as empty
          # sent the reader looking for a value that was never inline.
          printf '    collapsed to one before apply; live value comes from %s\n' "$source"
        fi
        printf '    the other value was dropped silently — check which you meant\n'
      else
        printf '    not present on %s/%s container %s in this namespace\n' \
          "$workload" "$ckind" "$container"
      fi
    done <<EOF
$(kl_duplicate_env_vars "$f")
EOF
  done <<EOF
$(kl_manifest_files "$KL_ROOT/$KL_MANIFESTS")
EOF
  if [ "$found" = 0 ] && [ "$unreadable" = 0 ]; then
    printf '  no duplicate env declarations in %s file(s)\n' "$scanned"
  fi
  return 0
}

# ---------------------------------------------------------------------------
# the rest
# ---------------------------------------------------------------------------
cmd_down() {
  kl_load_config
  require_cluster
  if [ "${1:-}" != "--yes" ]; then
    printf 'Delete namespace %s on context %s, and everything in it? [y/N] ' \
      "$KL_NAMESPACE" "$KL_CONTEXT" >&2
    local reply
    read -r reply
    case "$reply" in [yY] | [yY][eE][sS]) ;; *) kl_die "aborted" ;; esac
  fi
  # `--` stops kubectl reading a namespace that begins with a dash as a flag.
  # kl_require_dns_label already rejects those, so this is the second lock.
  kl_kubectl delete namespace --wait=false -- "$KL_NAMESPACE"
  kl_step "deleting in the background; klocal status will show when it is gone"
}

# logs and psql reach into a running pod, so they need the same guard as the
# write commands: without it, `klocal psql -c 'DROP ...'` runs against whatever
# context happens to be current, production included.
cmd_logs() {
  kl_load_config
  require_cluster
  local workload=${1:-$KL_APP}
  kl_require_dns_label "workload argument" "$workload"
  kl_kubectl logs -n "$KL_NAMESPACE" "deployment/$workload" -f --tail=100
}

cmd_rebuild() {
  kl_load_config
  preflight
  kl_info "build $KL_IMAGE"
  kl_build_image "$KL_IMAGE" "$KL_ROOT/$KL_IMAGE_CONTEXT"
  # The tag has not changed, so the Deployment spec has not changed either and
  # `apply` would be a no-op. A restart is what makes the kubelet pick up the
  # new image under the same tag.
  kl_info "restart"
  kl_kubectl rollout restart "deployment/$KL_APP" -n "$KL_NAMESPACE"
  kl_kubectl rollout status "deployment/$KL_APP" -n "$KL_NAMESPACE" --timeout=180s
}

cmd_psql() {
  kl_load_config
  require_cluster
  [ -n "$KL_DB" ] || kl_die "no workloads.db in $KL_CONFIG"
  # Default to the owning role, because migrations and inspection need it. --app
  # connects as the least-privilege application role instead, which is how you
  # check that row-level security actually bites.
  local user=${KL_DB_SUPERUSER:-postgres}
  if [ "${1:-}" = "--app" ]; then
    shift
    [ -n "$KL_DB_APP_ROLE" ] ||
      kl_die "--app needs \"database\": { \"appRole\": ... } in $KL_CONFIG"
    user=$KL_DB_APP_ROLE
  fi

  # psql lets a later option win, and a connection URI overrides -U outright, so
  # a trailing `-U postgres` or `postgresql://...` would quietly undo the role
  # this command just selected. Refuse rather than appear to have honoured it.
  local a
  for a in "$@"; do
    case "$a" in
      -U | --username | --username=* | -d | --dbname | --dbname=* | -h | --host | --host=* | \
        postgres://* | postgresql://*)
        kl_die "refusing: '$a' would override the connection klocal selected.
       Change \"database\" in $KL_CONFIG instead, or run psql yourself."
        ;;
    esac
  done
  # -t only when stdin really is a terminal: kubectl warns and degrades when it
  # is not, which turns every scripted `klocal psql -c ...` into noise.
  local tty=""
  [ -t 0 ] && tty="-t"
  # shellcheck disable=SC2086 # $tty is a single deliberate flag or empty
  kl_kubectl exec -i $tty -n "$KL_NAMESPACE" "deploy/$KL_DB" -- \
    psql -U "$user" -d "${KL_DB_NAME:-postgres}" "$@"
}

cmd_scaffold() {
  local dest=${1:-$PWD}
  [ -d "$dest" ] || kl_die "not a directory: $dest"
  [ -d "$KL_TEMPLATES" ] || kl_die "templates not found at $KL_TEMPLATES"

  mkdir -p "$dest/.k8s-local" "$dest/deploy/k8s-local" "$dest/deploy/local"

  local wrote=0 f base target
  for f in "$KL_TEMPLATES"/*; do
    [ -f "$f" ] || continue
    base=$(basename "$f")
    case "$base" in
      project.json) target="$dest/.k8s-local/$base" ;;
      https-proxy.mjs) target="$dest/deploy/local/$base" ;;
      *) target="$dest/deploy/k8s-local/$base" ;;
    esac
    if [ -e "$target" ]; then
      kl_step "skip (exists) ${target#"$dest"/}"
      continue
    fi
    cp "$f" "$target"
    kl_step "wrote ${target#"$dest"/}"
    wrote=$((wrote + 1))
  done

  kl_info "scaffolded $wrote file(s) into $dest"
  kl_step "next: edit .k8s-local/project.json, then the PROJECT placeholders in deploy/"
  kl_step "the namespace in deploy/k8s-local/kustomization.yaml must match project.json"
}

# ---------------------------------------------------------------------------
main() {
  local cmd=${1:-help}
  [ $# -gt 0 ] && shift || true
  case "$cmd" in
    up) cmd_up "$@" ;;
    down) cmd_down "$@" ;;
    status) cmd_status "$@" ;;
    logs) cmd_logs "$@" ;;
    rebuild) cmd_rebuild "$@" ;;
    psql) cmd_psql "$@" ;;
    scaffold) cmd_scaffold "$@" ;;
    help | -h | --help) usage ;;
    *)
      printf 'klocal: unknown command %s\n\n' "$cmd" >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
