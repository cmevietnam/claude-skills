#!/usr/bin/env bash
# opgate — reach 1Password secrets from an agent session, one Touch ID at a time.
#
# Design rule, and the reason this wrapper exists at all: a secret value must never
# reach the agent's stdout. Anything printed there lands in the conversation
# transcript and is shipped to a model provider, which defeats the point of keeping
# the secret in a vault. So secrets only ever travel to
#   * the environment of a child process   (run, exec)
#   * the macOS clipboard                  (copy)
#   * a git-ignored regular file           (inject)
# There is deliberately no `opgate read`.
#
# What this does NOT do: stop a determined caller. See references/security-model.md.
set -euo pipefail

OPGATE_BIN_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
OPGATE_SCRIPT_DIR=$(cd -- "$OPGATE_BIN_DIR/../scripts" && pwd)
# shellcheck source=../scripts/lib/common.sh
source "$OPGATE_SCRIPT_DIR/lib/common.sh"
# shellcheck source=../scripts/lib/gate.sh
source "$OPGATE_SCRIPT_DIR/lib/gate.sh"
# shellcheck source=../scripts/lib/classify.sh
source "$OPGATE_SCRIPT_DIR/lib/classify.sh"
# shellcheck source=../scripts/lib/scan.sh
source "$OPGATE_SCRIPT_DIR/lib/scan.sh"

usage() {
  cat >&2 <<'USAGE'
opgate — Touch ID-gated access to 1Password secrets

  opgate run    [-f FILE] -- CMD...     chạy CMD với secrets nạp vào env (mask sẵn)
  opgate exec   VAR=op://… -- CMD...    nạp đúng một secret cho một lệnh
  opgate inject -i TPL -o OUT           render template ra file (bắt buộc gitignored)
  opgate copy   op://… [--seconds N]    secret -> clipboard, tự xoá sau N giây (mặc định 90)
  opgate put    ITEM FIELD [--multiline] ghi một secret VÀO 1Password (đọc từ stdin)

  opgate scan   [PATH]                  tìm .env và secret nhúng trong project (không in giá trị)
  opgate import FILE [--yes]            đưa một file .env vào vault + sinh .env.op
  opgate items  [-p PROJECT]            liệt kê item trong vault theo project

  opgate list   [-f FILE]               liệt kê tên biến + ref (không bao giờ in giá trị)
  opgate doctor [--test-gate]           kiểm tra toàn bộ setup
  opgate audit  [-n N]                  xem nhật ký truy cập
  opgate build                          build lại binary Touch ID gate + ghi hash

Không có `opgate read` — cố ý. Xem references/security-model.md.
Mỗi lệnh chạm vào secret đều hỏi Touch ID; không có cache, không có cách tắt.

Env: OPGATE_VAULT (Dev) · OPGATE_ENV_FILE (.env.op) · OPGATE_ALLOW_PASSWORD (1 để
     cho phép dùng mật khẩu máy thay vân tay)
USAGE
}

# A short, readable rendering of the command for the Touch ID sheet. Arguments are
# bracketed so a value containing spaces cannot masquerade as two arguments, and
# newlines are flattened so nothing can be pushed out of view.
cmd_summary() {
  local out="" a
  for a in "$@"; do
    a=${a//$'\n'/ }; a=${a//$'\t'/ }
    out+="[$a]"
  done
  (( ${#out} > 90 )) && out="${out:0:87}…"
  printf '%s' "$out"
}

require_op() {
  command -v op >/dev/null 2>&1 \
    || die "1Password CLI chưa có. Cài: brew install --cask 1password-cli"
}
require_jq() {
  command -v jq >/dev/null 2>&1 \
    || die "opgate put cần jq. Cài: brew install jq"
}

# Run a command with a hard time limit. macOS ships no `timeout(1)`, and every
# `op` call can block forever while 1Password is locked.
with_timeout() { # <seconds> <cmd...>
  local secs="$1"; shift
  "$@" & local pid=$!
  ( sleep "$secs"; kill -9 "$pid" 2>/dev/null ) >/dev/null 2>&1 & local watcher=$!
  local rc=0; wait "$pid" 2>/dev/null || rc=$?
  kill -9 "$watcher" 2>/dev/null
  return $rc
}

# Where a path really lands, after resolving `..` and any symlinked parent.
resolved_path() {
  local p="$1" dir base
  dir=$(dirname -- "$p"); base=$(basename -- "$p")
  dir=$(cd -- "$dir" 2>/dev/null && pwd -P) || die "thư mục không tồn tại: $(dirname -- "$p")"
  printf '%s/%s' "$dir" "$base"
}

# --- subcommands ------------------------------------------------------------

cmd_list() {
  local file=""
  while (( $# )); do
    case "$1" in
      -f|--env-file) [[ $# -ge 2 ]] || die "-f cần một đường dẫn"; file="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) die "opgate list: tham số lạ '$1'" ;;
    esac
  done
  file=$(resolve_env_file "$file")

  printf '%s\n' "$file"
  local n=0 name value
  # Only op:// references are safe to print. A literal value is, by definition, the
  # thing we are trying to keep out of the transcript — show that it exists, not
  # what it is.
  while IFS=$'\t' read -r name value; do
    [[ -n "$name" ]] || continue
    if [[ "$value" == op://* ]]; then
      printf '  %s = %s\n' "$name" "$value"
    else
      printf '  %s = <giá trị literal, không in>\n' "$name"
    fi
    n=$((n + 1))
  done < <(env_file_pairs "$file")

  local literals; literals=$(env_file_literals "$file" || true)
  if [[ -n "$literals" ]]; then
    warn "các biến sau chứa giá trị literal chứ không phải op:// ref — đó là secret plaintext trong file lẽ ra commit được:"
    printf '        %s\n' $literals >&2
  fi
  (( n > 0 )) || warn "không có biến nào trong $file"
}

cmd_run() {
  require_op
  local file=""; local -a CMD=()
  while (( $# )); do
    case "$1" in
      -f|--env-file) [[ $# -ge 2 ]] || die "opgate run: -f cần một đường dẫn"
                     file="$2"; shift 2 ;;
      -h|--help)     usage; exit 0 ;;
      --)            shift; CMD=("$@"); break ;;
      -*)            die "opgate run: tham số lạ '$1' (cú pháp: opgate run [-f FILE] -- CMD...)" ;;
      *)             CMD=("$@"); break ;;
    esac
  done
  (( ${#CMD[@]} )) || die "opgate run: thiếu lệnh cần chạy — ví dụ: opgate run -- npm run dev"
  file=$(resolve_env_file "$file")

  local -a vars=(); local v
  while IFS= read -r v; do [[ -n "$v" ]] && vars+=("$v"); done < <(env_file_vars "$file")
  (( ${#vars[@]} )) || die "$file không khai báo biến nào"

  # A literal in this file is not a vault secret, so `op run` will not mask it if
  # the child prints it. You should know that before approving.
  local literals; literals=$(env_file_literals "$file" || true)
  [[ -n "$literals" ]] && warn "$(basename -- "$file") có giá trị literal ($(printf '%s ' $literals)) — op run KHÔNG che được chúng"

  # The env file is named in the prompt: two projects, or a staging file, otherwise
  # look identical at the moment you are deciding.
  gate_require "run" "$(basename -- "$file"): $(IFS=,; printf '%s' "${vars[*]}")" \
    "$(project_name)/$(basename -- "$file") → chạy $(cmd_summary "${CMD[@]}") với $(summarize_list "${vars[@]}")"

  # 1Password masks these values in the child's stdout/stderr by default. Never
  # pass --no-masking here.
  exec op run --env-file="$file" -- "${CMD[@]}"
}

cmd_exec() {
  require_op
  local spec=""; local -a CMD=()
  while (( $# )); do
    case "$1" in
      -h|--help) usage; exit 0 ;;
      --)        shift; CMD=("$@"); break ;;
      *)         if [[ -z "$spec" ]]; then spec="$1"; shift
                 else CMD=("$@"); break; fi ;;
    esac
  done
  [[ -n "$spec" ]] || die "opgate exec: thiếu secret reference — ví dụ: opgate exec DB=op://Dev/app/DB -- psql"
  (( ${#CMD[@]} )) || die "opgate exec: thiếu lệnh cần chạy"

  local name ref
  if [[ "$spec" == *=op://* ]]; then
    name="${spec%%=*}"; ref="${spec#*=}"
  elif [[ "$spec" == op://* ]]; then
    ref="$spec"; name="${ref##*/}"
  else
    die "opgate exec: '$spec' không phải secret reference (mong đợi op://... hoặc VAR=op://...)"
  fi
  require_safe_var_name "$name"

  # The full reference goes on the sheet, not just the variable name:
  # DATABASE_URL=op://Prod/admin/root and a dev reference look identical otherwise.
  gate_require "exec" "$name=$ref" \
    "$(project_name) → chạy $(cmd_summary "${CMD[@]}") với $name = $ref"

  export "$name=$ref"
  exec op run -- "${CMD[@]}"
}

cmd_inject() {
  require_op
  local tpl="" out="" force=0
  while (( $# )); do
    case "$1" in
      -i|--in-file)  [[ $# -ge 2 ]] || die "-i cần một đường dẫn"; tpl="$2"; shift 2 ;;
      -o|--out-file) [[ $# -ge 2 ]] || die "-o cần một đường dẫn"; out="$2"; shift 2 ;;
      --force) force=1; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die "opgate inject: tham số lạ '$1'" ;;
    esac
  done
  [[ -n "$tpl" && -n "$out" ]] || die "opgate inject cần cả -i TEMPLATE và -o OUTPUT"
  [[ -f "$tpl" ]] || die "không có template: $tpl"

  # Where the write really lands, not what the argument looks like. `--force` does
  # NOT relax these: a device node, FIFO or symlink target is how a "file" write
  # becomes a write to the transcript or to somewhere you did not name.
  local real; real=$(resolved_path "$out")
  case "$real" in
    /dev/*|/proc/*)
      die "từ chối ghi vào $real — đó không phải file, secret sẽ đi thẳng ra stdout/stderr hoặc thiết bị.
       Cần secret cho một lệnh thì dùng: opgate run -- <cmd>" ;;
  esac
  if [[ -L "$out" ]]; then
    die "$out là symlink — từ chối, đích thật có thể nằm ngoài chỗ bạn nghĩ (trỏ tới $(readlink -- "$out"))"
  fi
  if [[ -e "$real" && ! -f "$real" ]]; then
    die "$real tồn tại nhưng không phải file thường (FIFO, socket, thiết bị?) — từ chối ghi"
  fi

  # Rendering secrets to disk is the one operation here that leaves plaintext
  # behind, so refuse unless git is already set up to ignore the result.
  if ! git check-ignore -q -- "$out" 2>/dev/null; then
    if (( force )); then
      warn "$out KHÔNG được git ignore — đang ghi vì có --force. Đừng commit file này."
    else
      die "$out chưa được git ignore. Thêm nó vào .gitignore trước, hoặc dùng --force nếu bạn chắc.
       Cân nhắc \`opgate run\` thay thế — nó không ghi secret xuống đĩa."
    fi
  fi

  local -a vars=(); local v
  while IFS= read -r v; do [[ -n "$v" ]] && vars+=("$v"); done < <(env_file_vars "$tpl")
  # A JSON/YAML template holds op:// references that are not VAR= lines, so fall
  # back to counting references rather than claiming "(none)" on the prompt.
  local refcount; refcount=$(grep -o 'op://[^"'"'"' 	]*' -- "$tpl" 2>/dev/null | wc -l | tr -d ' ')
  local scope
  if (( ${#vars[@]} )); then scope=$(summarize_list "${vars[@]}")
  else scope="$refcount tham chiếu op://"; fi

  gate_require "inject" "$(basename -- "$tpl") -> $real" \
    "$(project_name) → ghi secret ra file $(basename -- "$real"): $scope"

  ( umask 077; op inject -i "$tpl" -o "$real" -f )
  chmod 600 "$real" 2>/dev/null || true
  info "đã ghi $real (chmod 600) — xoá khi dùng xong"
}

cmd_copy() {
  require_op
  command -v pbcopy >/dev/null 2>&1 || die "opgate copy cần pbcopy (macOS)"
  local ref="" seconds=90
  while (( $# )); do
    case "$1" in
      --seconds) [[ $# -ge 2 ]] || die "--seconds cần một số"
                 require_int "$2" "--seconds"; seconds="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      op://*) ref="$1"; shift ;;
      *) die "opgate copy: tham số lạ '$1'" ;;
    esac
  done
  [[ -n "$ref" ]] || die "opgate copy cần một secret reference op://..."

  gate_require "copy" "$ref" \
    "$(project_name) → chép $ref vào clipboard trong ${seconds}s"

  op read --no-newline "$ref" | pbcopy

  # Hash what we just placed, once. An earlier version re-read the vault after the
  # delay to compare — a second, ungated secret access, which is exactly what this
  # tool exists to prevent, and which also failed to clear the clipboard whenever
  # the session had expired by then.
  local placed; placed=$(pbpaste 2>/dev/null | /usr/bin/shasum -a 256 | cut -d' ' -f1)
  info "đã chép ${ref##*/} vào clipboard; sẽ tự xoá sau ${seconds}s"
  warn "clipboard manager hoặc Universal Clipboard có thể vẫn giữ bản sao"

  # Clear only if the clipboard still holds what we put there, so we never wipe
  # something you copied in the meantime.
  ( sleep "$seconds"
    if [[ "$(pbpaste 2>/dev/null | /usr/bin/shasum -a 256 | cut -d' ' -f1)" == "$placed" ]]; then
      printf '' | pbcopy
    fi ) >/dev/null 2>&1 &
  disown 2>/dev/null || true
}

cmd_put() {
  require_op; require_jq
  local item="" field="" multiline=0
  while (( $# )); do
    case "$1" in
      --multiline) multiline=1; shift ;;
      -h|--help) usage; exit 0 ;;
      *) if   [[ -z "$item"  ]]; then item="$1";  shift
         elif [[ -z "$field" ]]; then field="$1"; shift
         else die "opgate put: tham số lạ '$1'"; fi ;;
    esac
  done
  [[ -n "$item" && -n "$field" ]] || die "cú pháp: opgate put <ITEM> <FIELD> [--multiline]  (giá trị đọc từ stdin)"

  local value
  if [[ ! -t 0 ]]; then
    # Piped input is taken whole: a PEM key or JSON blob must not be truncated at
    # the first newline. Only one trailing newline is stripped.
    value=$(cat; printf x); value="${value%x}"; value="${value%$'\n'}"
  elif (( multiline )); then
    printf 'Dán giá trị cho %s/%s rồi Ctrl-D:\n' "$item" "$field" >&2
    value=$(cat; printf x); value="${value%x}"; value="${value%$'\n'}"
  else
    printf 'Giá trị cho %s/%s (ẩn, một dòng; dùng --multiline cho nhiều dòng): ' "$item" "$field" >&2
    IFS= read -rs value; printf '\n' >&2
  fi
  [[ -n "$value" ]] || die "giá trị rỗng, không ghi gì"

  gate_require "put" "$item/$field" \
    "$(project_name) → lưu $field vào item \"$item\" trong vault $OPGATE_VAULT"

  # Does the item exist? stdout is discarded so the existing secrets never land in
  # a shell variable; only op's error text is captured. A failure that is not
  # "no such item" must not be mistaken for one, or we would create a duplicate
  # item on a transient network or authorization error.
  local probe_err="" exists=1
  probe_err=$(op item get "$item" --vault "$OPGATE_VAULT" --format json </dev/null 2>&1 >/dev/null) || exists=0
  if (( ! exists )); then
    case "$probe_err" in
      *"isn't an item"*|*"could not find"*|*"no item matching"*|*"not found"*) ;;
      *) die "không truy vấn được item \"$item\": $probe_err" ;;
    esac
  fi

  # The value reaches jq through a file descriptor, never through argv — `op` warns
  # in its own help that command arguments are visible to other processes, and the
  # same is true of jq. Nothing is written to disk at any point: the item JSON is
  # piped straight from `op item get` into `op item edit`.
  if (( exists )); then
    op item edit "$item" --vault "$OPGATE_VAULT" --template <(
      op item get "$item" --vault "$OPGATE_VAULT" --format json </dev/null \
        | jq --rawfile v <(printf '%s' "$value") --arg f "$field" '
            .fields = ((.fields // []) | map(select(.label != $f)))
                    + [{ id: $f, type: "CONCEALED", label: $f, value: $v }]'
    ) </dev/null >/dev/null
    info "đã cập nhật $field trên item \"$item\""
  else
    # Fields must be top level (no section) so the reference stays
    # op://<vault>/<item>/<VAR>. notesPlain is part of the stock Secure Note
    # template; omitting it makes `op` reject the template.
    op item create --vault "$OPGATE_VAULT" --template <(
      jq -n --rawfile v <(printf '%s' "$value") --arg t "$item" --arg f "$field" '
        { title: $t, category: "SECURE_NOTE",
          fields: [ { id: "notesPlain", type: "STRING", purpose: "NOTES", label: "notesPlain", value: "" },
                    { id: $f, type: "CONCEALED", label: $f, value: $v } ] }'
    ) </dev/null >/dev/null
    info "đã tạo item \"$item\" với field $field"
  fi
  info "reference: op://$OPGATE_VAULT/$item/$field"
}

cmd_audit() {
  local n=20
  while (( $# )); do
    case "$1" in
      -n) [[ $# -ge 2 ]] || die "-n cần một số"; require_int "$2" "-n"; n="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) die "opgate audit: tham số lạ '$1'" ;;
    esac
  done
  [[ -f "$OPGATE_AUDIT_LOG" ]] || { info "chưa có nhật ký ($OPGATE_AUDIT_LOG)"; return 0; }
  printf 'TIME\tSTATUS\tCALLER\tPROJECT\tACTION\tDETAIL\n'
  tail -n "$n" -- "$OPGATE_AUDIT_LOG"
}

cmd_doctor() {
  local test_gate=0 fail=0
  while (( $# )); do
    case "$1" in
      --test-gate) test_gate=1; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die "opgate doctor: tham số lạ '$1'" ;;
    esac
  done

  info "kiểm tra setup"

  if command -v op >/dev/null 2>&1; then
    ok "1Password CLI $(op --version 2>/dev/null)"
  else
    bad "chưa có 1Password CLI → brew install --cask 1password-cli"; fail=1
  fi

  if command -v jq >/dev/null 2>&1; then
    ok "jq $(jq --version 2>/dev/null)"
  else
    bad "chưa có jq (opgate put cần nó) → brew install jq"; fail=1
  fi

  if command -v op >/dev/null 2>&1; then
    if op vault list --format json </dev/null >/dev/null 2>&1; then
      ok "op ủy quyền được (desktop app integration)"
      if op vault get "$OPGATE_VAULT" --format json </dev/null >/dev/null 2>&1; then
        ok "vault \"$OPGATE_VAULT\" tồn tại"
      else
        bad "chưa có vault \"$OPGATE_VAULT\" → op vault create $OPGATE_VAULT"; fail=1
      fi
    else
      bad "op không ủy quyền được → mở 1Password, Settings ▸ Developer ▸ Integrate with 1Password CLI, rồi unlock app"; fail=1
    fi
  fi

  if [[ -x "$OPGATE_GATE_BIN" ]]; then
    local vrc=0; _verify_gate_binary >/dev/null 2>&1 || vrc=$?
    if (( vrc == 2 )); then
      bad "gate binary khác hash đã ghi lúc build → xác nhận rồi chạy: opgate build"; fail=1
    else
      ok "gate binary: $OPGATE_GATE_BIN"
    fi
  else
    bad "chưa build gate binary → opgate build"; fail=1
  fi

  [[ "${OPGATE_ALLOW_PASSWORD:-}" =~ ^(1|true|yes)$ ]] \
    && warn "OPGATE_ALLOW_PASSWORD bật — mật khẩu máy được chấp nhận thay vân tay"

  local file=""
  if file=$(resolve_env_file "" 2>/dev/null); then
    local count; count=$(env_file_vars "$file" | grep -c . || true)
    ok "$file — $count biến"
    local literals; literals=$(env_file_literals "$file" || true)
    if [[ -n "$literals" ]]; then
      bad "giá trị literal (không phải op:// ref) trong $file: $(printf '%s ' $literals)"; fail=1
    fi
  else
    warn "project này chưa có $OPGATE_ENV_FILE_DEFAULT (xem references/project-setup.md)"
  fi

  local root; root=$(git rev-parse --show-toplevel 2>/dev/null || printf '%s' "$PWD")
  local -a plaintext=()
  local f
  for f in "$root"/.env "$root"/.env.local "$root"/*/.env; do
    [[ -f "$f" ]] && plaintext+=("${f#"$root"/}")
  done
  if (( ${#plaintext[@]} )); then
    warn "còn .env plaintext trong repo: $(printf '%s ' "${plaintext[@]}")"
  fi

  if (( test_gate )); then
    info "đang thử prompt xác thực — chạm vân tay để xác nhận…"
    if gate_require "doctor" "self-test" "$(project_name) → opgate doctor self-test"; then
      ok "prompt xác thực hoạt động"
    fi
  fi

  if (( fail )); then
    printf '\n' >&2; warn "có mục chưa đạt (xem ✘ ở trên)"; return 1
  fi
  printf '\n' >&2; info "tất cả ổn"
}

# Parse one env file into the parallel arrays IMP_NAMES / IMP_VALUES.
# bash 3.2 has no associative arrays, hence two arrays kept in step.
parse_env_file() { # <file>
  local file="$1" line name value
  IMP_NAMES=(); IMP_VALUES=()
  # `|| [[ -n "$line" ]]` keeps the final line when the file has no trailing
  # newline — dropping it would silently skip the last variable.
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    [[ "$line" =~ ^[[:space:]]*$ ]] && continue
    [[ "$line" =~ ^[[:space:]]*(export[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*[[:space:]]*= ]] || continue

    name="${line%%=*}"
    name="${name#"${name%%[![:space:]]*}"}"      # ltrim
    name="${name%"${name##*[![:space:]]}"}"      # rtrim
    name="${name#export }"
    name="${name%"${name##*[![:space:]]}"}"

    value="${line#*=}"
    value="${value#"${value%%[![:space:]]*}"}"   # ltrim
    # Strip one matching pair of surrounding quotes.
    if   [[ "$value" == \"*\" && ${#value} -ge 2 ]]; then value="${value:1:${#value}-2}"
    elif [[ "$value" == \'*\' && ${#value} -ge 2 ]]; then value="${value:1:${#value}-2}"
    else value="${value%"${value##*[![:space:]]}"}"
    fi

    IMP_NAMES+=("$name"); IMP_VALUES+=("$value")
  done < "$file"
}

cmd_scan() {
  local target="" env_only=0
  while (( $# )); do
    case "$1" in
      --env-only) env_only=1; shift ;;
      -h|--help) usage; exit 0 ;;
      *) target="$1"; shift ;;
    esac
  done
  local root
  if [[ -n "$target" ]]; then root=$(cd -- "$target" && pwd -P)
  else root=$(git rev-parse --show-toplevel 2>/dev/null || printf '%s' "$PWD"); fi
  local project; project=$(basename -- "$root")

  printf 'project: %s\n%s\n\n' "$project" "$root"

  local -a envfiles=(); local f
  while IFS= read -r f; do [[ -n "$f" ]] && envfiles+=("$f"); done < <(find_env_files "$root")

  # Best effort, time-boxed: a locked 1Password makes `op` block indefinitely, and
  # scan must still be useful with no vault access at all.
  local vault_titles=""
  vault_titles=$(with_timeout 5 op item list --vault "$OPGATE_VAULT" --format json 2>/dev/null \
                 | jq -r '.[].title' 2>/dev/null) || vault_titles=""
  [[ -n "$vault_titles" ]] || info "không đọc được vault (khoá hoặc chưa cấu hình) — bỏ qua cột trạng thái"

  if (( ${#envfiles[@]} == 0 )); then
    printf 'không tìm thấy file .env nào\n'
  else
    printf 'file env (%d):\n' "${#envfiles[@]}"
    local i n v kind s c pl em item rel
    for f in ${envfiles[@]+"${envfiles[@]}"}; do
      rel="${f#"$root"/}"
      item=$(item_name_for "$f" "$project" "$root")
      parse_env_file "$f"
      s=0; c=0; pl=0; em=0
      for (( i = 0; i < ${#IMP_NAMES[@]}; i++ )); do
        kind=$(classify_var "${IMP_NAMES[$i]}" "${IMP_VALUES[$i]}")
        case "$kind" in
          secret|ambiguous) s=$((s+1)) ;;
          config) c=$((c+1)) ;;
          placeholder) pl=$((pl+1)) ;;
          empty) em=$((em+1)) ;;
        esac
      done
      printf '  %-40s -> op://%s/%s/<VAR>' "$rel" "$OPGATE_VAULT" "$item"
      if [[ -z "$vault_titles" ]]; then
        printf '\n'
      elif printf '%s' "$vault_titles" | grep -qxF "$item"; then
        printf '  [đã có trong vault]\n'
      else
        printf '  [chưa có]\n'
      fi
      printf '     %d cần vault · %d config · %d placeholder · %d rỗng\n' "$s" "$c" "$pl" "$em"
    done
    printf '\n  đưa vào vault:  opgate import <file>\n'
  fi

  (( env_only )) && return 0

  printf '\nsecret nhúng trong file khác:\n'
  local hits=0 cf ln label
  while IFS= read -r cf; do
    [[ -n "$cf" ]] || continue
    while IFS=$'\t' read -r ln label; do
      [[ -n "$ln" ]] || continue
      printf '  %s:%s\t%s\n' "${cf#"$root"/}" "$ln" "$label"
      hits=$((hits + 1))
    done < <(scan_embedded "$cf")
  done < <(find_config_files "$root")

  if (( hits == 0 )); then
    printf '  không thấy gì\n'
  else
    printf '\n  %d chỗ. Đây là giá trị nằm trong file cấu hình hoặc source, không phải\n' "$hits"
    printf '  biến môi trường — `opgate import` KHÔNG tự sửa được vì phải đổi code.\n'
    printf '  Nếu là credential thật thì rotate; opgate chỉ nói chỗ, không in giá trị.\n'
  fi
}

cmd_import() {
  require_op; require_jq
  local file="" project="" item="" assume_yes=0 dry=0
  while (( $# )); do
    case "$1" in
      -p|--project) [[ $# -ge 2 ]] || die "--project cần một tên"; project="$2"; shift 2 ;;
      --item)       [[ $# -ge 2 ]] || die "--item cần một tên"; item="$2"; shift 2 ;;
      -y|--yes)     assume_yes=1; shift ;;
      --dry-run)    dry=1; shift ;;
      -h|--help)    usage; exit 0 ;;
      *) [[ -z "$file" ]] || die "opgate import: chỉ nhận một file"; file="$1"; shift ;;
    esac
  done
  [[ -n "$file" ]] || die "cú pháp: opgate import <file .env> [--project NAME] [--item NAME] [--yes]"
  [[ -f "$file" ]] || die "không có file: $file"
  file=$(resolved_path "$file")

  local root; root=$(git rev-parse --show-toplevel 2>/dev/null || dirname -- "$file")
  [[ -n "$project" ]] || project=$(basename -- "$root")
  [[ -n "$item" ]] || item=$(item_name_for "$file" "$project" "$root")

  parse_env_file "$file"
  (( ${#IMP_NAMES[@]} )) || die "$file không có biến nào"

  # Decide what goes to the vault. Ambiguous entries are settled by you, and the
  # question shows the SHAPE of the value, never the value: deciding does not
  # require seeing it, and printing it would put it in the transcript.
  local -a vault_idx=() literal_idx=() ambiguous_idx=()
  local i name kind ans
  for (( i = 0; i < ${#IMP_NAMES[@]}; i++ )); do
    name="${IMP_NAMES[$i]}"
    kind=$(classify_var "$name" "${IMP_VALUES[$i]}")
    case "$kind" in
      secret)  vault_idx+=("$i") ;;
      config|placeholder|empty) literal_idx+=("$i") ;;
      ambiguous) ambiguous_idx+=("$i") ;;
    esac
  done

  # An ambiguous variable is a judgement call, so it is yours. `--yes` sends them
  # all to the vault, which is the safe direction: a config value in the vault
  # costs a round trip, a secret left in a committable file costs a rotation.
  if (( ${#ambiguous_idx[@]} )); then
    if (( assume_yes )); then
      # Checked before --dry-run so that `--yes --dry-run` previews the real plan
      # rather than a list of questions it would never ask.
      for i in ${ambiguous_idx[@]+"${ambiguous_idx[@]}"}; do vault_idx+=("$i"); done
      ambiguous_idx=()
    elif (( dry )); then
      : # listed separately below; a dry run must not prompt
    elif [[ -t 0 ]]; then
      printf '\n%d biến không phân loại được chắc chắn. Giá trị KHÔNG được in ra —\n' "${#ambiguous_idx[@]}" >&2
      printf 'chỉ mô tả hình dạng, vì in ra là đưa nó vào transcript.\n\n' >&2
      for i in ${ambiguous_idx[@]+"${ambiguous_idx[@]}"}; do
        printf '  %s — %s\n' "${IMP_NAMES[$i]}" "$(describe_value "${IMP_VALUES[$i]}")" >&2
        printf '    đưa vào vault? [Y/n] ' >&2
        # Read from stdin, which the `-t 0` above proved is a terminal. Reading
        # /dev/tty instead looked equivalent and was not: it opens successfully in
        # an agent session with a controlling terminal nobody is watching, returns
        # EOF immediately, and every ambiguous variable silently defaulted to yes.
        IFS= read -r ans || ans=y
        case "$ans" in [nN]*) literal_idx+=("$i") ;; *) vault_idx+=("$i") ;; esac
      done
    else
      # No terminal to ask on — an agent running this unattended. Refuse rather
      # than guess: guessing wrong either leaks a secret into a committable file
      # or quietly vaults something that did not need it.
      printf '\n' >&2
      for i in ${ambiguous_idx[@]+"${ambiguous_idx[@]}"}; do
        printf '  %s — %s\n' "${IMP_NAMES[$i]}" "$(describe_value "${IMP_VALUES[$i]}")" >&2
      done
      die "${#ambiguous_idx[@]} biến ở trên cần bạn quyết, nhưng không có terminal để hỏi.
       Chạy lại trong terminal, hoặc thêm --yes để đưa tất cả chúng vào vault."
    fi
  fi

  local -a vault_names=()
  for i in ${vault_idx[@]+"${vault_idx[@]}"}; do vault_names+=("${IMP_NAMES[$i]}"); done

  printf '\n%s\n' "$file" >&2
  printf '  vault  : %s -> op://%s/%s/<VAR>\n' "${#vault_idx[@]} biến" "$OPGATE_VAULT" "$item" >&2
  printf '  literal: %s giữ nguyên trong .env.op\n' "${#literal_idx[@]} biến" >&2
  (( ${#ambiguous_idx[@]} )) && printf '  chờ hỏi: %s\n' "${#ambiguous_idx[@]} biến" >&2

  if (( dry )); then
    printf '\n  --dry-run: không ghi gì\n' >&2
    for i in ${vault_idx[@]+"${vault_idx[@]}"}; do printf '    vault     %s\n' "${IMP_NAMES[$i]}" >&2; done
    for i in ${ambiguous_idx[@]+"${ambiguous_idx[@]}"}; do
      printf '    sẽ hỏi   %s — %s\n' "${IMP_NAMES[$i]}" "$(describe_value "${IMP_VALUES[$i]}")" >&2
    done
    for i in ${literal_idx[@]+"${literal_idx[@]}"}; do printf '    literal   %s\n' "${IMP_NAMES[$i]}" >&2; done
    return 0
  fi
  (( ${#vault_idx[@]} )) || die "không có biến nào cần đưa vào vault"

  # One approval for the whole file. Per-variable prompts would mean dozens of
  # Touch ID sheets for a real project, and a control you turn off is worth less
  # than one you keep. The sheet lists every variable being written.
  gate_require "import" "$item: $(IFS=,; printf '%s' "${vault_names[*]}")" \
    "$(project_name) → nhập $(basename -- "$file") vào item \"$item\": $(summarize_list "${vault_names[@]}")"

  # Merge with an existing item so re-importing does not drop fields added
  # elsewhere. A failure that is not "no such item" must not be read as one.
  local fields_json probe_err="" exists=1
  probe_err=$(op item get "$item" --vault "$OPGATE_VAULT" --format json </dev/null 2>&1 >/dev/null) || exists=0
  if (( exists )); then
    fields_json=$(op item get "$item" --vault "$OPGATE_VAULT" --format json </dev/null | jq '.fields // []')
  else
    case "$probe_err" in
      *"isn't an item"*|*"could not find"*|*"no item matching"*|*"not found"*) ;;
      *) die "không truy vấn được item \"$item\": $probe_err" ;;
    esac
    fields_json='[{"id":"notesPlain","type":"STRING","purpose":"NOTES","label":"notesPlain","value":""}]'
  fi

  # Values reach jq over a file descriptor, never argv.
  for i in ${vault_idx[@]+"${vault_idx[@]}"}; do
    fields_json=$(printf '%s' "$fields_json" \
      | jq --arg f "${IMP_NAMES[$i]}" --rawfile v <(printf '%s' "${IMP_VALUES[$i]}") \
          'map(select(.label != $f)) + [{id: $f, type: "CONCEALED", label: $f, value: $v}]')
  done

  local tags="opgate,project:$project"
  if (( exists )); then
    op item edit "$item" --vault "$OPGATE_VAULT" --tags "$tags" --template <(
      printf '%s' "$fields_json" | jq --arg t "$item" '{title: $t, category: "SECURE_NOTE", fields: .}'
    ) </dev/null >/dev/null
    info "cập nhật item \"$item\" (${#vault_idx[@]} biến)"
  else
    op item create --vault "$OPGATE_VAULT" --tags "$tags" --template <(
      printf '%s' "$fields_json" | jq --arg t "$item" '{title: $t, category: "SECURE_NOTE", fields: .}'
    ) </dev/null >/dev/null
    info "tạo item \"$item\" (${#vault_idx[@]} biến), tag: $tags"
  fi

  # Write .env.op next to the original.
  local opfile; opfile="$(dirname -- "$file")/.env.op"
  {
    printf '# sinh bởi `opgate import` từ %s\n' "$(basename -- "$file")"
    printf '# commit được: chỉ chứa op:// reference và giá trị không bí mật.\n'
    printf '# chạy: opgate run -- <lệnh>\n\n'
    for (( i = 0; i < ${#IMP_NAMES[@]}; i++ )); do
      local in_vault=0 j
      for j in ${vault_idx[@]+"${vault_idx[@]}"}; do [[ "$j" == "$i" ]] && in_vault=1; done
      if (( in_vault )); then
        printf '%s=op://%s/%s/%s\n' "${IMP_NAMES[$i]}" "$OPGATE_VAULT" "$item" "${IMP_NAMES[$i]}"
      else
        printf '%s=%s\n' "${IMP_NAMES[$i]}" "${IMP_VALUES[$i]}"
      fi
    done
  } > "$opfile"
  info "ghi $opfile"

  # Keep the original. Deleting it is your call, made after you have confirmed the
  # app still runs — a missed variable with no backup is unrecoverable.
  local backup_dir="$OPGATE_HOME/backups"
  mkdir -p -- "$backup_dir"
  local backup="$backup_dir/${item}-$(date +%Y%m%d-%H%M%S).env"
  ( umask 077; cp -- "$file" "$backup" )
  info "sao lưu bản gốc: $backup"

  if ! git check-ignore -q -- "$file" 2>/dev/null; then
    warn "$(basename -- "$file") CHƯA được git ignore — thêm vào .gitignore trước khi commit"
  fi
  info "kiểm tra:  opgate run -f $opfile -- <lệnh>"
  info "xoá bản gốc sau khi chắc chắn mọi thứ chạy: rm $file"
}

cmd_items() {
  require_op
  local project=""
  while (( $# )); do
    case "$1" in
      -p|--project) [[ $# -ge 2 ]] || die "-p cần một tên"; project="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) die "opgate items: tham số lạ '$1'" ;;
    esac
  done
  [[ -n "$project" ]] || project=$(project_name)
  printf 'vault %s · tag project:%s\n' "$OPGATE_VAULT" "$project"
  op item list --vault "$OPGATE_VAULT" --tags "project:$project" </dev/null 2>&1
}

# --- dispatch ---------------------------------------------------------------

sub="${1:-help}"; shift || true
case "$sub" in
  run)    cmd_run    "$@" ;;
  exec)   cmd_exec   "$@" ;;
  inject) cmd_inject "$@" ;;
  copy)   cmd_copy   "$@" ;;
  put)    cmd_put    "$@" ;;
  list)   cmd_list   "$@" ;;
  scan)   cmd_scan   "$@" ;;
  import) cmd_import "$@" ;;
  items)  cmd_items  "$@" ;;
  audit)  cmd_audit  "$@" ;;
  doctor) cmd_doctor "$@" ;;
  build)  bash "$OPGATE_SCRIPT_DIR/build-gate.sh" ;;
  read)   die "opgate không có lệnh \`read\` — cố ý. In secret ra stdout sẽ đưa nó vào transcript của model.
       Dùng \`opgate run -- <cmd>\` (nạp vào env), \`opgate copy <ref>\` (clipboard), hoặc \`opgate inject\` (file gitignored)." ;;
  help|-h|--help) usage ;;
  *) printf 'opgate: không rõ lệnh "%s"\n\n' "$sub" >&2; usage; exit 64 ;;
esac
