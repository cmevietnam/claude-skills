# Viettel S-Invoice (hóa đơn điện tử) configuration.
#
# Copy the values into the platform's secret store, not into the repository.
# `vinvoice --env-file <this file> check` proves the whole set in one call.

# The dark switch. While false, the reconciler and the worker are complete
# no-ops — AND EVERY SETTLED PAYMENT ACCUMULATES AS AN UNISSUED TAX OBLIGATION
# that will be filed when it flips.
VIETTEL_INVOICE_ENABLED=false

# Must include everything up to and including /InvoiceAPI. https only.
#   production: https://api-vinvoice.viettel.vn/services/einvoiceapplication/api/InvoiceAPI
#   sandbox:    issued per account, e.g. https://demo-sinvoice.viettel.vn:8443/InvoiceAPI
VIETTEL_INVOICE_BASE_URL=

# basic | token. Basic is what the vendor's own collection uses on every invoice
# endpoint; token exists but its path is not documented publicly — do not enable
# it until it is wired from the vendor's integration document.
VIETTEL_INVOICE_AUTH_MODE=basic

# The username IS the supplier tax code on every account the vendor ships,
# branch suffix included (0100109106-507).
VIETTEL_INVOICE_USERNAME=
VIETTEL_INVOICE_PASSWORD=
VIETTEL_INVOICE_SUPPLIER_TAX_CODE=

# mẫu số and ký hiệu, registered with the tax authority. `vinvoice templates`
# lists what this account actually has; a wrong value is rejected on every call.
VIETTEL_INVOICE_TEMPLATE_CODE=1/001
VIETTEL_INVOICE_SERIAL=

# item_type -> VAT rate. Negative values are codes, not rates: -1 KCT, -2 KKKNT.
# Agree these with an accountant; they end up on a tax filing.
VIETTEL_INVOICE_TAX_RATES={"course":10,"service_fee":8}
VIETTEL_INVOICE_DEFAULT_TAX_RATE=10

# THE GO-LIVE FLOOR, RFC3339. Required whenever the feature is enabled, and the
# one value nothing else can protect you from: a moment in the past back-dates a
# real invoice for every payment settled after it.
VIETTEL_INVOICE_START_AT=2026-09-01T00:00:00+07:00

# Zero-amount payments (free enrolments, 100%-off vouchers) are recorded as a
# terminal 'skipped' row rather than invoiced.
VIETTEL_INVOICE_SKIP_ZERO_AMOUNT=true

# Read by the application and by the `vinvoice` CLI alike (the CLI also accepts
# VINVOICE_TIMEOUT, which wins when both are set).
VIETTEL_INVOICE_TIMEOUT_SECONDS=20

# If the application egresses through a forward proxy, the proxy's address is
# what Viettel must whitelist — and it needs its own credential.
# EGRESS_PROXY_URL=
# EGRESS_PROXY_VIETTEL_USER=
# EGRESS_PROXY_VIETTEL_PASS=
